    function SaveDVoucher() {
        var date = $('#dtpDate').val();
        if (date == "" || date == null) {
            alert("Date can not be null");
        }
        else {
            var tdebit = parseFloat($('#sumdebit').text());
            var tcredit = parseFloat($('#sumcredit').text());
            var rowCount = $('#mytable tbody tr').length;
            if (rowCount <= 0) {
                alert("Must have rows to save.")
            }
            else {
                if (tdebit != tcredit) {
                    alert("Debit & Credit Total Must Be Equal.")
                }
                else {
                    var answer = confirm("Do You really want to Save this?");
                    if (answer) {
                        var date = $('#dtpDate').val();
                        var vid = $('#txtVochNo').val();
                        var detail = [];
                        $('#mytable tbody tr').each(function () {
                            var $row = $(this), $tds = $row.find("td");
                            detail.push({
                                accCode: $tds[0].innerText,
                                title: $tds[1].innerText,
                                debit: $tds[2].innerText,
                                credit: $tds[3].innerText,
                                naration: $tds[4].innerText,
                                isctrlacc: $tds[5].innerText
                            });
                        });
                        var model = {
                            vid: vid,
                            date: date,
                            isupdate: IsUpdate,
                            isprint: IsPrintJV,
                            detail: detail
                        };
                        $.ajax({
                            url: "/SaleJVoucher/SaveVoucher",
                            type: "POST",
                            data: JSON.stringify({ model: model }),
                            dataType: 'text json',
                            async: false,
                            contentType: 'application/json; charset=utf-8',
                            success: function (response) {
                                if (response != null && response.success) {
                                    alert(response.responseText);
                                    if (IsPrintJV) {
                                        var string = "rtype=rptSJVReceipt" + "&txtAccCode=" + vid + "";
                                        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
                                        window.open(url, "_blank");
                                    }
                                    window.location.reload();
                                }
                                else {
                                    alert(response.responseText);
                                }
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                        IsUpdate = false;
                        IsPrintJV = false;
                    }
                }
            }
        }
    }
    function DeleteClicked() {
        var dvid = $('#txtVochNo').val();
        var date = $('#dtpDate').val();
        if (dvid == "" || dvid == null || date == "" || date == null) {
            alert("Date or voucher id can not be null");
