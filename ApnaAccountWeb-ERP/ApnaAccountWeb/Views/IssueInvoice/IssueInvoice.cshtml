                                var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
                                window.open(url, "_blank");

                            }
                            window.location.reload();
                        }
                        else {
                            alert(response.responseText);
                        }
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
                @* var date = $('#dtpDate').val();
            var vid = $('#txtVochNo').val();
            var string = "Date=" + date + "&ISUpdate=" + IsUpdate + "&IsPrintDV=" + IsPrintJV + "&VID=" + vid + "";
            var url = '@(Url.Action("SaveDVVoucher", "DVoucher", null, Request.Url.Scheme))?' + string
            window.location.href = url;
            IsUpdate = false;
            IsPrintJV = false;*@
                IsUpdate = false;
                IsPrintJV = false;
                //}
            }
        }
        // }
    }

    function PrintReport() {
        var vid = $('#compno').val();
        if (vid == "" || vid == null) {
            alert("Invoice id can not be null");
        }
        else {
            var string = "rtype=rptIssueInvoice" + "&txtAccCode=" + vid + "";
            var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
            window.open(url, "_blank");
        }

    }

    function DeleteClicked() {
        var dvid = $('#compno').val();
        var date = $('#comDate').val();
        if (dvid == "" || dvid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var answer = confirm("Do You really want to Delete this?");
            if (answer) {


                $('#btnSave').show();
                $('#btnGo').hide();
                IsUpdate = true;

                var string = "Date=" + date + "&DVId=" + dvid + "";

                var url = '@(Url.Action("DeleteInvoice", "IssueInvoice", null, Request.Url.Scheme))?' + string;
                window.location.href = url;
            }
        }
    }

</script>



<div id="content">
    <div class="row">
