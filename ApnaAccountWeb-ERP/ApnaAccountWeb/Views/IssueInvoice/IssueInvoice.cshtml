                                </div>
                            </div>
                        </div>

                        <div class="form-actions mt-3">
                            <div class="row">
                                <div class="col-md-1">
                                    <input type="button" value="New" id="btnNew" class="btn btn-primary btn-block" onclick='NewClicked();'>
                                   
                                </div>
                                <div class="col-md-1">
                                    <input type="button" id="btnDelete" class="btn btn-danger btn-block" value="Delete" onclick='DeleteClicked();'>
                                </div>
                                <div class="col-md-1">
                                    <input type="button" value="Search" id="btnSearch" class="btn btn-default btn-block" onclick='SearchClicked();' />
                                    <input type="button" value="Save" id="btnSave" class="btn btn-success btn-block" onclick='SaveDVoucher();'>
                                     <input type="button" id="btnGo" value="Go" class="btn btn-success btn-block" onclick='SearchDV();'>
                                </div>

                                <div class="col-md-1">
                                    <input type="button" id="btnClose" value="Clear" class="btn btn-warning btn-block" onclick='ClearClicked();'>
                                </div>
                                <div class="col-md-2">
                                    <input type="button" id="btnPrint" value="Print Preview" class="btn btn-success btn-block" style="background-color: #f4429b" onclick='PrintReport();'>
                                </div>
                            </div>
                        </div>
                    </form>


                </div>
            </div>
        </div>
    </div>
</div>
