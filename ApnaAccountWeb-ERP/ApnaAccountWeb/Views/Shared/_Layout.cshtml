    <script>
        $(document).ready(function () {
            if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|BB|PlayBook|IEMobile|Windows Phone|Kindle|Silk|Opera Mini/i.test(navigator.userAgent)) {
                $(".ac").hide();
                $(".ac2").show();
            }
            //SetupSessionUpdater('/Home/KeepSessionAlive');
            //Url.Action("KeepSessionAlive","Home")
            setInterval("fnSessionRun()", 50000);
        });
    </script>
    <script>
        //var SessionTimer = $("#hdnSessionTimeout").val();
        var flag = true;
        function fnSessionRun() {
            SessionOKClick();
        }
        function SessionOKClick() {
            //ajax call to reset session
            $.ajax({
                url: '/Common/ResetSession/',
                contentType: 'application/json',
                dataType: 'json',
                data: {},
                success: function (data) {
                },
                error: function (e) {
                    alert(e);
                }
            });
        }
        $(document).ajaxStart(function (event, jqxhr, settings) {
            //SessionTimer = parseInt($("#hdnSessionTimeout").val());
        });
    </script>
    <style>
        tr.normal td {
            color: black;
            background-color: white;
        }
        tr.highlighted td {
            color: white;
            background-color: #062f70;
        }
    </style>
</head>
