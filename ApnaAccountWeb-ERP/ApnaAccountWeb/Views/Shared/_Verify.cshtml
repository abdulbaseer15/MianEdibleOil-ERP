                $("#mytable tr").remove();
                var new_row;
                var date2;
                new_row = "<tr><th>Voucher No</th><th>Date</th><th>Type</th><th>Amount</th><th>City</th><th>Verify</th><th>View</th></tr>"
                //$('#mytable tbody').append(new_row);
                $.each(result, function (i, item) {
                    debugger;
                    //date2 = new Date(item.VDate);
                    //new_row += "<tr id='row" + i + "' ><td class='VID'>" + item.Vid + "</td><td class='Vtype'>" + item.Vtype + "</td><td class='title'>" + item.title + "</td><td class='debit'>" + item.debit + "</td><td class='credit'>" + item.credit + "</td><td class='naration'>" + item.narration + "</td><td><input type='checkbox' name='vv'></td></tr>";
                    new_row += "<tr id='row" + i + "' ><td class='VID2'> " + item.Vid2 + "</td><td class='VDate'> " + item.VDate + "</td><td class='VID hidden'>" + item.Vid + "</td><td class='Vtype'>" + item.Vtype + "</td><td class='Amount'>" + item.Ttldebit + "</td><td class='City'>" + item.City + "</td><td><input type='checkbox' name='vv'></td><td><span class='editrow'><a class='fa fa-edit' href='javascript: void(0);'>View Voucher</a></span></td></tr>";
