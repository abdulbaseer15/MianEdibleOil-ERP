    $(document).ready(function () {
        $('#txtVochNo').attr('disabled', 'disabled');
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        $('#txtAccCode').disable(true);
        $('#ddlTitle').disable(true);
        $('#txtDebit').disable(true);
        $('#txtCredit').disable(true);
        $('#txtNarration').disable(true);
        $('#btnDelete').disable(true);
        $('#ddlAType').disable(true);
        $('#btnSave').hide();
        $('#btnGo').hide();
        //$('#cbxPrintJV').disable(true);
        $("#divSelectDis").hide();
        //$("#tempdata").hide();
        $('#dtpDate').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpDate').datepicker('setDate', 'now');
    });
    function SearchDV() {
        debugger;
        var narration = $('#Narration').val();
       // $('#btnSave').show();
       // $('#btnGo').hide();
        IsUpdate = true;
        $.ajax({
            type: "GET",       // make it get request instead //
            url: "/VouchersVerification/SearchVoucher",
            data: { Narration: narration },
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                $("#mytable tr").remove();
                var new_row;
                new_row = "<tr><th hidden>AccountId</th><th>Debit</th><th>Credit</th><th>Narration</th><th>VDate</th><th>Vtype</th><th>Title</th><th hidden>Ref No</th><th>Verify</th></tr>"
                //$('#mytable tbody').append(new_row);
                $.each(result, function (i, item) {
                    var a = (item.VDate);
                    a = a.toString("dd/MM/yyyy");
                    //var date = item.ForMonth;
                    var parsedDate = new Date(parseInt(a.substr(6)));
                    var newDate = new Date(parsedDate);
                    var getMonth = newDate.getMonth() + 1;
                    var getDay = newDate.getDate();
                    var getYear = newDate.getFullYear();
                    var standardDate = getDay + '/' + getMonth + '/' + getYear;
                    //$('#comDate').datepicker('setDate', standardDate);
                    //new_row += "<tr id='row" + i + "' ><td class='VID'>" + item.Vid + "</td><td class='Vtype'>" + item.Vtype + "</td><td class='title'>" + item.title + "</td><td class='debit'>" + item.debit + "</td><td class='credit'>" + item.credit + "</td><td class='naration'>" + item.narration + "</td><td><input type='checkbox' name='vv'></td></tr>";
                    new_row += "<tr id='row" + i + "' ><td class='AccountId hidden'> " + item.AccountId + "</td><td class='Debit'> " + item.Debit + "</td><td class='Creadit'> " + item.Credit + "</td><td class='Narration'> " + item.Narration + "</td><td class='VID' hidden>" + item.VId + "</td><td class='VDate'>" + standardDate + "</td><td class='Vtype'>" + item.Vtype + "</td><td class='VId2' hidden>" + item.VId2 + "</td><td class='Title'>" + item.Title + "</td><td class='RefNo hidden'>" + item.RefNo + "</td><td><span class='editrow'><a class='fa fa-edit' href='javascript: void(0);'>View Voucher</a></span></td></tr>";
                });
                $('#mytable tbody').append(new_row);
                $("#tempdata").show();
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
    }
    function SearchDV3() {
