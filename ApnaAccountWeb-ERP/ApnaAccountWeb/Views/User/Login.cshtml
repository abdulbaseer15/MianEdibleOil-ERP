@model ApnaAccountWeb.Models.Ini_Company
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login Page</title>
    <link rel="stylesheet" href="~/Content/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/Content/dist/css/adminlte.min.css">
    <link href="~/Content/css/style.css" rel="stylesheet" />
</head>
<body>
    <div class="hold-transition login-page">
        <div class="login-box">
            <div class="login-logo">
                <a href="../../index2.html"><b>APNA </b>ACCOUNT</a>
                @*<img src="~/Content/img/logo.png" width="200" />*@
            </div>
            <div class="card">
                <div class="card-body login-card-body">
                    <p class="login-box-msg">Sign in to start your session</p>
                    <form action="Login" method="Post" enctype="multipart/form-data">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Username" id="UserName" name="UserName" required value="iag">
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    @*<span class="fas fa-envelope"></span>*@
                                </div>
                            </div>
                            @*<input type="email" class="form-control" placeholder="Email">*@
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-user"></span>
                                </div>
                            </div>
                        </div>
                        <div class="input-group mb-3">
                            <input type="password" class="form-control" id="Password" name="Password" placeholder="Password" required value="iag123">
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-lock"></span>
                                </div>
                            </div>
                        </div>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" id="code" name="code" placeholder="Company Code" required value="1853">
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <span class="fas fa-star"></span>
                                </div>
                            </div>
                        </div>
                        @if (null != TempData["message"])
                        {
                            <p style="padding-left:2em;">@TempData["message"]</p>
                        }
                        <div class="row">
                            @*<div class="col-8">
                <div class="icheck-primary">
                    <input type="checkbox" id="remember">
                    <label for="remember">
                        Remember Me
                    </label>
                </div>
            </div>*@
                            <!-- /.col -->
                            <div class="col-md-5 col-sm-12">
                                <button type="submit" class="btn btn-primary btn-block">Sign In</button>
                            </div>
                            <!-- /.col -->
                        </div>
                    </form>
                    <!--<div class="social-auth-links text-center mb-3">
                    <p>- OR -</p>
                    <a href="#" class="btn btn-block btn-primary">
                        <i class="fab fa-facebook mr-2"></i> Sign in using Facebook
                    </a>
                    <a href="#" class="btn btn-block btn-danger">
                        <i class="fab fa-google-plus mr-2"></i> Sign in using Google+
                    </a>
                </div>-->
                    <!-- /.social-auth-links -->
                    <!--<p class="mb-1">
                    <a href="forgot-password.html">I forgot my password</a>
                </p>-->
                    @*<p class="mb-0">
                        <a href="@Url.Action("Registeration","User")" class="text-center">Register a new membership</a>
                    </p>*@
                </div>
            </div>
        </div>
    </div>
    <div class="login-footer">
        <div>
            Developed by <a href="https://www.iagsoft.com.pk/"> IAG Soft </a> - All rights reserved 2024
        </div>
    </div>
    <script src="../../dist/js/adminlte.min.js"></script>
</body>
</html>
