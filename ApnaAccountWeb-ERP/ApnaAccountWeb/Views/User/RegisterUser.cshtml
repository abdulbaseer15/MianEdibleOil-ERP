@model ApnaAccountWeb.Models.User
@if (null != TempData["message"])
{
    <script type="text/javascript">
       alert("@TempData["message"]");
    </script>
}
@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span6">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Create User</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form action="RegisterUser" method="Post" enctype="multipart/form-data" class="form-horizontal">
                                <div class="control-group">
                                    <label class="control-label">Name:</label>
                                    <div class="controls">
                                        <input type="text" id="UserName" name="UserName" required placeholder="Name" />
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Password:</label>
                                    <div class="controls">
                                        <input type="password" id="Password" name="Password" required placeholder="Password" />
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Type:</label>
                                    <div class="controls">
                                        <select id="UserType" name="UserType">
                                            <option>User</option>
                                            <option>Admin</option>
                                            <option>Manager</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Office:</label>
                                    <div class="controls">
                                        <select id="Office" name="Office">
                                            <option value="HO">Head Office</option>
                                            <option value="FO">Factory Office</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Cell No:</label>
                                    <div class="controls">
                                        <input type="text" id="PhNo" name="PhNo" required placeholder="PhNo" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <a href="@Url.Action("ViewUser", "User")" style="padding-right:2em;">View Users</a>
                                    <button type="submit" class="btn btn-success">Save</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}

@if (1 == 1)
{
    <div id="content">
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">
                        <b>Create User</b>
                    </div>
                    <div class="card-body">
                        <form action="RegisterUser" method="Post" enctype="multipart/form-data" class="form-horizontal">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Name:</label>
                                        <input type="text" class="form-control form-control-sm" id="UserName" name="UserName" required placeholder="Name" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Password:</label>
                                        <input type="password" class="form-control form-control-sm" id="Password" name="Password" required placeholder="Password" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Type:</label>
                                        <select id="UserType" class="form-control form-control-sm" name="UserType">
                                            <option>User</option>
                                            <option>Admin</option>
                                            <option>Manager</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Office:</label>
                                        <select id="Office" class="form-control form-control-sm" name="Office">
                                            <option value="HO">Head Office</option>
                                            <option value="FO">Factory Office</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Cell No:</label>
                                        <input type="text" id="PhNo" class="form-control form-control-sm" name="PhNo" required placeholder="PhNo" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-2">
                                    <button type="submit" class="btn btn-sm btn-success">Save</button>
                                </div>
                                <div class="col-md-6 col-sm-6 col-10">
                                    <div class="text-right">
                                        <a class="btn btn-sm btn-default" href="@Url.Action("ViewUser", "User")">View Users</a>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}      