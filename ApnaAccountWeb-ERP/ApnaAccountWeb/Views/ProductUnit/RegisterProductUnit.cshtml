             @model ApnaAccountWeb.Models.ProductUnit 
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<div id="content">
  <div class="container-fluid">
    <div class="row-fluid">
         <div class="span6">
        <div class="widget-box">
          <div class="widget-title"> <span class="icon"> <i class="icon-align-justify"></i> </span>
            <h5>Create Product Unit</h5>
          </div>
          <div class="widget-content nopadding">
             <form action="RegisterProductUnit" method="Post" enctype="multipart/form-data" class="form-horizontal">
                 <div class="control-group">
                <label class="control-label">Title:</label>
                <div class="controls">
                  <input type="text" id="Title" name="Title" required  placeholder="Title" />
                </div>
              </div>
              <div class="form-actions">
                 <a href="@Url.Action("ViewProductUnit", "ProductUnit")" style="padding-right:2em;">View Products Unit</a>
                <button type="submit" class="btn btn-success">Save</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div><hr>
  </div>
</div>
<script>
    var keys = {};
    $(document).keydown(function (e) {
        keys[e.which] = true;
        if (e.target.nodeName.toLowerCase() !== 'input')
        printKeys();
    });
    $(document).keyup(function (e) {
        delete keys[e.which];
        if (e.target.nodeName.toLowerCase() !== 'input')
        printKeys();
    });
