                                <div class="form-actions">
                                    <button type="submit" class="btn btn-success">Save</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<script>
    $('#cash').change(function () {
        var selectedVal = $("#cash option:selected").text();
        $('#cashtitle').val(selectedVal);
    });
    $('#cash2').change(function () {
        var selectedVal = $("#cash2 option:selected").text();
        $('#cashtitle2').val(selectedVal);
    });
    $('#bank').change(function () {
        var selectedVal = $("#bank option:selected").text();
        $('#banktitle').val(selectedVal);
    });
    $('#purchase').change(function () {
        var selectedVal = $("#purchase option:selected").text();
        $('#purchasetitle').val(selectedVal);
    });
    $('#sale').change(function () {
        var selectedVal = $("#sale option:selected").text();
        $('#saletitle').val(selectedVal);
    });
</script>
