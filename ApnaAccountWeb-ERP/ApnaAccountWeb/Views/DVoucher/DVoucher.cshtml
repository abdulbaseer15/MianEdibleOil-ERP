        else {
            var string = "rtype=rptHODVReceipt" + "&txtAccCode=" + $('#txtVoucherID').val() + "&dtpDatefrom=" + date + "&title=" + vid + "";
            var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
            window.open(url, "_blank");
        }
    }
    function DeleteClicked() {
        var dvid = $('#txtVoucherID').val();
        var date = $('#dtpDate').val();
        if (dvid == "" || dvid == null || date == "" || date == null) {
            alert("Date or voucher id can not be null");
        }
        else {
            var answer = confirm("Do You really want to Delete this?");
            if (answer) {
                $('#btnSave').show();
                $('#btnGo').hide();
                IsUpdate = true;
                var string = "Date=" + date + "&DVId=" + dvid + "";
                var url = '@(Url.Action("DeleteVoucher", "DVoucher", null, Request.Url.Scheme))?' + string;
                window.location.href = url;
            }
        }
    }
</script>
