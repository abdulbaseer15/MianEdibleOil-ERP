<div id="content">
    <div class="row">
        <div class="col-md-6">
            <form action="RegisterVehicleType" method="Post" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <b>Create Vehicle Type</b>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" class="form-control form-control-sm" id="" name="VType" required placeholder="Name" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-2">
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                            </div>
                            <div class="col-md-6 col-sm-6 col-10">
                                <div class="text-right">
                                    <a class="btn btn-sm btn-default" href="@Url.Action("ViewVehicleType", "VehicleType")">View Vehicle Type</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>       