 @model ApnaAccountWeb.Models.VehicleType  
<div id="content">
  <div class="container-fluid">
    <div class="row-fluid">
         <div class="span6">
        <div class="widget-box">
          <div class="widget-title"> <span class="icon"> <i class="icon-align-justify"></i> </span>
            <h5>Edit Vehicle Type</h5>
          </div>
          <div class="widget-content nopadding">
             <form action="Edit" method="Post" enctype="multipart/form-data" class="form-horizontal">
                 <input type="hidden" id="VID" name="VID" value="@Model.VID" />
                 <div class="control-group">
                <label class="control-label">Name:</label>
                <div class="controls">
                    <input type="text" id="VType" name="VType" required value="@Convert.ToString(Model.VType)" /> 
                </div>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn btn-success">Update</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div><hr>
  </div>
</div>
               