    function forOrder2() {
        var flag = true;
        var trows = document.getElementById('tblPopupinv').rows;
        var countrow = -1; // Initialize countrow to -1

        // Initialize the table rows and set up onclick event
        for (var i = 0; i < trows.length; i++) {
            var trow = trows[i];
            trow.className = 'normal';
            trow.onclick = highlightRow;
        }

        function highlightRow(gethighlight) {
            gethighlight = gethighlight === true;
            var t = trows.length;

            for (var i = 0; i < t; i++) {
                var trow = trows[i];
                if (gethighlight && trow.className === 'highlighted') {
                    countrow = i; // Update countrow to the index of the highlighted row
                    return i;
                } else if (!gethighlight && trow !== this) {
                    trow.className = 'normal';
                }
            }

            return gethighlight ? null : this.className = this.className === 'highlighted' ? 'normal' : 'highlighted';
        }

        function movehighlight(way) {
            var idx = highlightRow(true), nextrow;

            if (typeof idx === 'number') {
                var startIndex = idx + way;
                while (startIndex >= 0 && startIndex < trows.length) {
                    nextrow = trows[startIndex];
                    if (nextrow.style.display !== 'none') {
                        countrow = startIndex;
                        return highlightRow.apply(nextrow);
                    }
                    startIndex += way; // Move to the next row
                }
            }

            // If no visible rows found, cycle to the first or last displayed row
            for (var j = way > 0 ? 0 : trows.length - 1; (way > 0 ? j < trows.length : j >= 0) ; j += (way > 0 ? 1 : -1)) {
                if (trows[j].style.display !== 'none') {
                    countrow = j;
                    return highlightRow.apply(trows[j]);
                }
            }
        }

        function processkey(e) {
            e = e || window.event;
            switch (e.keyCode) {
                case 38: // Up Arrow
                    $('#tblPopupinv').focus();
                    flag = false;
                    return movehighlight(-1);
                case 40: // Down Arrow
                    $('#tblPopupinv').focus();
                    flag = true;
                    return movehighlight(1);
                case 13: // Enter Key
                    if ($("#tblPopupinv").is(":focus")) {
                        if (countrow >= 0) {
                            var selectedRow = trows[countrow];
                            var $tds = $(selectedRow).find("td");

                            // Fetch values from the selected row
                            $('#compno').val($tds[0].innerText);
                            $('#comDate').val($tds[1].innerText);
                            $('#myModalinvoices').modal('hide');
                            $('#comDate').prop("disabled", true);
                            $('#compno').prop("disabled", true);
                            $('#btnGo').focus();
                            countrow = -1; // Reset countrow
                            return;
                        }
                    }
                    break;
                default:
                    return true; // Allow other keys to function normally
            }
        }

        document.onkeydown = processkey; // Set the keydown event handler
    }

