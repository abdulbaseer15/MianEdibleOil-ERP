<div id="content">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <b>Purchase Order</b>
                </div>
                <div class="card-body">
                    <form action="#" method="Post" enctype="multipart/form-data" class="form-horizontal">
                        <input type="hidden" class="form-control form-control-sm" id="piecesperbox" name="piecesperbox" />
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Computer #</label>
                                    <input type="text" class="form-control form-control-sm" id="compno" name="compno" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Invoice Date</label>
                                    <div class="input-group date" data-target-input="nearest">
                                        <input type="text" class="form-control form-control-sm" id="comDate" name="comDate" />
                                        <div class="input-group-append" id="comDateIcon" data-target="#comDate" data-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Reference No</label>
                                    <input type="text" class="form-control form-control-sm" id="invono" name="invono" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Reference Date</label>
                                    <div class="input-group date" data-target-input="nearest">
                                        <input type="text" class="form-control form-control-sm" id="youDate" name="youDate" />
                                        <div class="input-group-append" id="youDateIcon" data-target="#youDate" data-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Supplier</label>
                                    <input type="text" class="form-control form-control-sm" id="txtsupCode" name="txtsupCode" data-toggle="tooltip" title="Press enter and select account code" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Supplier Title</label>
                                    @{List<SelectListItem> AccCodelist = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.AccCodelist)
                                    {
                                        AccCodelist.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Acc.AccountId
                                        });
                                    }
                                    }
                                    @Html.DropDownListFor(u => u.AccTitle, AccCodelist, "-- Select Account --", new { id = "ddlTitlesup", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-md-3" hidden>
                                <div class="form-group">
                                    <label>Rate Calc:</label>
                                    <select id="ratecalc" name="ratecalc" class="form-control form-control-sm">
                                        <option>--Calc Rate--</option>
                                        <option>BAGS</option>
                                        <option>KG</option>
                                        <option>MOND</option>
                                        <option>PIECES</option>
                                        <option>METER</option>
                                        <option>FEET</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Mill Type:</label>
                                    <select id="milltype" name="milltype" class="form-control form-control-sm">
                                        <option>--Select Mill--</option>
                                        <option>EX MILL</option>
                                        <option>MILL</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Brockery Rate</label>
                                    <input type="number" class="form-control form-control-sm" id="txtbrorate" name="txtbrorate" />
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>MODE:</label>
                                    <select id="mode" name="mode" class="form-control form-control-sm">
                                        <option></option>
                                        <option>AMOUNT</option>
                                        <option>BAG</option>
                                        <option>MOND</option>
                                        <option>TRUCK</option>
                                        <option>VEHICLE</option>
                                        <option>PIECES</option>
                                        <option>METER</option>
                                        <option>FEET</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label>Code</label>
                                    <input type="text" class="form-control form-control-sm" id="txtproCode" name="txtproCode" />
                                    @*<input type="text" class="form-control form-control-sm" id="txtproCode" name="txtproCode" data-toggle="tooltip" title="Press enter and select product code" />*@
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>Product Name</label>
                                    <input type="text" class="form-control form-control-sm" id="ddlTitlepro" name="ddlTitlepro" readonly />
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label>Quantity</label>
                                    <input type="number" class="form-control form-control-sm" id="txtquan" name="txtquan" />
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label>Weight</label>
                                    <input type="number" class="form-control form-control-sm" id="txtweight" name="txtweight" />
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label>Rate</label>
                                    <input type="number" class="form-control form-control-sm" id="txtrate" name="txtrate" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Amount</label>
                                    <input type="number" class="form-control form-control-sm" id="txtamount" name="txtamount" readonly data-toggle="tooltip" title="Press enter or add button to save" />
                                </div>
                            </div>
                            <div class="col-md-1 align-content-center">
                                <input type="button" value="Add" id="btnaddgrid" class="btn btn-sm btn-default mt-3" onclick='AddGridClicked();' />
                            </div>
                        </div>
                        <div id="tempdata">
                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <table class="table table-bordered table-responsive" id="mytable">
                                        <thead>
                                            <tr>
                                                <th style="width: 10%;">Code</th>
                                                <th style="width: 40%;">Product Name</th>
                                                <th style="width: 5%;">Quantity</th>
                                                <th style="width: 10%;">Weight</th>
                                                <th style="width: 10%;">Rate</th>
                                                <th style="width: 10%;">Amount</th>
                                                <th style="width: 15%;">Action</th>
                                            </tr>
                                        </thead>
