                data: { Date: date, VId: dvid },
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result.length > 0) {
                        var new_row;
                        var tamount = 0;
                        $.each(result, function (i, item) {
                            tamount = tamount + item.Amount;
                            new_row += "<tr id='row" + i + "' ><td class='accCode'>" + item.ProductID + "</td><td class='title'>" + item.ProductName + "</td><td class='unitid'>" + item.QtyDr + "</td><td class='unitname'>" + item.WtDr + "</td><td class='rate'>" + item.Rate + "</td><td class='naration'>" + item.Amount + "</td><td><span class='editrow'><a class='fa fa-edit' href='javascript: void(0);'>Edit</a></span>|<span class='deleterow'><a class='glyphicon glyphicon-trash' href=''>Delete</a></span></td></tr>";
                            $('#ratecalc').val(item.RateCalc);
                            $('#milltype').val(item.MillType);
                            $('#txtbrorate').val(item.Brate);
                            $('#mode').val(item.BrokeryMode);
                            $('#txtsupCode').val(item.AccountId);
                            $('#ddlTitlesup').val(item.AccountId);
                            var date = item.ForMonth;
                            var parsedDate = new Date(parseInt(item.PartyBillDate.substr(6)));
                            var newDate = new Date(parsedDate);
                            var getMonth = newDate.getMonth() + 1;
                            var getDay = newDate.getDate();
                            var getYear = newDate.getFullYear();
                            var pad = "00";
                            var result = (pad + getMonth).slice(-pad.length);
                            var result2 = (pad + getDay).slice(-pad.length);
                            var standardDate = result2 + '/' + result + '/' + getYear;
                            $('#youDate').val(standardDate);
                            $('#invono').val(item.PartyBillNO);
                        });
                        $('#nettotal').val(tamount);
                        $('#mytable tbody').append(new_row);
                        $("#tempdata").show();
                    }
                    else {
                        alert("No record found");
                        window.location.reload();
                    }
                },
                error: function (response) {
                    alert(response.responseText);
                }
            });
