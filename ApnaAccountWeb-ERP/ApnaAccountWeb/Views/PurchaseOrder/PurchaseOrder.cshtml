    var i = 0;
    currentRow = null;
    function AddGridClicked() {
        var accCode = $('#txtproCode').val();
        var product = $('#ddlTitlepro').val();
        var quan = parseFloat($('#txtquan').val());
        var weight = $('#txtweight').val();
        var rate = parseFloat($('#txtrate').val());
        var amount = $('#txtamount').val();
        if ($('#txtproCode').val() == "" || $('#txtproCode').val() == null || $("#ddlTitlepro option:selected").text() == "-- Select Account --") {
            alert("Cant Save You Must Select Account Code");
            $('#txtproCode').focus();
        }
        else {
            if ((amount == "" || amount == null || amount == 0 || amount < 0) || (rate == "" || rate == null || rate == 0 || rate < 0)) {
                alert("Amount or rate Cannot Empty or Zero")
                $('#txtrate').focus();
            }
            else {
                i++;
                var new_row = "<tr id='row" + i + "' ><td class='accCode'>" + accCode + "</td><td class='title'>" + product + "</td><td class='unitid'>" + quan + "</td><td class='unitname'>" + weight + "</td><td class='rate'>" + rate + "</td><td class='naration'>" + amount + "</td><td><span class='editrow'><a class='fa fa-edit' href='javascript: void(0);'>Edit</a></span>|<span class='deleterow'><a class='glyphicon glyphicon-trash' href=''>Delete</a></span></td></tr>";
                if (currentRow) {
                    $('#mytable').find($(currentRow)).replaceWith(new_row);
                    currentRow = null;
                }
                else {
                    $('#mytable').append(new_row);
                }
                var tamount = 0;
                $('#mytable tbody tr').each(function () {
                    var $row = $(this), $tds = $row.find("td");
                    var t1amount = parseFloat($tds[5].innerText);
                    if (isNaN(t1amount)) {
                        t1amount = 0;
                    }
                    tamount = tamount + t1amount;
                });
                $('#nettotal').val(tamount);
                $("#tempdata").show();
                IntiateFields();
                $('#txtproCode').focus();
            }
        }
    }
    function SaveDVoucher() {
        var date = $('#comDate').val();
        if (date == "" || date == null) {
            alert("Date can not be null");
        }
        else {
            var supid = $('#ddlTitlesup').val();
            var supname = $("#ddlTitlesup option:selected").text();
            var purid = $('#ddlTitlepur').val();
            var purname = $("#ddlTitlepur option:selected").text();
            if ((supid == "" || supid == null || supname == "" || supname == null)) {
                alert("Supplier account can not be empty or null");
            }
            else {
                var rowCount = $('#mytable tbody tr').length;
                if (rowCount <= 0) {
                    alert("Must have rows to save.")
                }
                else {
                    var answer = confirm("Do You really want to Save this?");
                    if (answer) {
                        $('#btnSave').disable(true);
                        var date = $('#comDate').val();
                        var vid = $('#compno').val();
                        //if (vid == "" || vid == null) {
                        //    vid = $('#ddlTitleinv').val();
                        //}
                        var detail = [];
                        var totalquantity = 0;
                        $('#mytable tbody tr').each(function () {
                            var $row = $(this), $tds = $row.find("td");
                            totalquantity += parseFloat($tds[2].innerText);
                            detail.push({
                                accCode: $tds[0].innerText,
                                title: $tds[1].innerText,
                                box: $tds[2].innerText,
                                piece: $tds[3].innerText,
                                rate: $tds[4].innerText,
                                amount: $tds[5].innerText
                            });
                        });
                        var model = {
                            vid: vid,
                            comdate: date,
                            yourinvoice: $('#invono').val(),
                            yourdate: $('#youDate').val(),
                            supid: $('#ddlTitlesup').val(),
                            supname: $("#ddlTitlesup option:selected").text(),
                            purid: $('#ratecalc').val(),
                            purname: $('#milltype').val(),
                            discount: $('#txtbrorate').val(),
                            nettotal: $('#nettotal').val(),
                            store: $('#mode').val(),
                            totalquantity: totalquantity,
                            isupdate: IsUpdate,
                            isprint: IsPrintJV,
                            detail: detail
                        };
                        //  alert(JSON.stringify(model));
                        $.ajax({
                            url: "/PurchaseOrder/SaveInvoice",
                            type: "POST",
                            data: JSON.stringify({ model: model }),
                            dataType: 'text json',
                            async: false,
                            contentType: 'application/json; charset=utf-8',
                            success: function (response) {
                                if (response != null && response.success) {
                                    alert(response.responseText);
                                    //$('#txtVochNo').val(response.responseText.toString());
                                    //$('#txtAccCode').disable(false);
                                    //$('#ddlTitle').disable(false);
                                    //$('#txtDebit').disable(false);
                                    //$('#txtCredit').disable(false);
                                    //$('#txtNarration').disable(false);
                                    //$("#txtAccCode").focus();
                                    //$('#btnSave').show();
                                    //$('#btnSearch').hide();
                                    if (IsPrintJV) {
                                        //alert("hurrah");
                                        var string = "rtype=rptPurchaseOrder" + "&txtAccCode=" + vid + "";
                                        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
                                        window.open(url, "_blank");
                                    }
                                    window.location.reload();
                                }
                                else {
                                    alert(response.responseText);
                                }
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                        @* var date = $('#dtpDate').val();
            var vid = $('#txtVochNo').val();
            var string = "Date=" + date + "&ISUpdate=" + IsUpdate + "&IsPrintDV=" + IsPrintJV + "&VID=" + vid + "";
            var url = '@(Url.Action("SaveDVVoucher", "DVoucher", null, Request.Url.Scheme))?' + string
            window.location.href = url;
            IsUpdate = false;
            IsPrintJV = false;*@
                        IsUpdate = false;
                        IsPrintJV = false;
                    }
                }
            }
        }
    }
    function PrintReport() {
        var vid = $('#compno').val();
        var date = $('#comDate').val();
        if (vid == "" || vid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var string = "rtype=rptPurchaseOrder" + "&txtAccCode=" + vid + "";
            var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
            window.open(url, "_blank");
        }
    }
    function DeleteClicked() {
        //var dvid = $('#ddlTitleinv').val();
        var dvid = $('#compno').val();
        var date = $('#comDate').val();
        if (dvid == "" || dvid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var answer = confirm("Do You really want to Delete this?");
            if (answer) {
                $('#btnSave').show();
                $('#btnGo').hide();
                IsUpdate = true;
                var string = "Date=" + date + "&DVId=" + dvid + "";
                var url = '@(Url.Action("DeleteInvoice", "PurchaseOrder", null, Request.Url.Scheme))?' + string;
                window.location.href = url;
            }
        }
    }
</script>
