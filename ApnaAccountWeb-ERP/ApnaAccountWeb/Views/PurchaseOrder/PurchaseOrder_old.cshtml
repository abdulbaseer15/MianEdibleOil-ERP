                });
                $('#nettotal').val(tamount);
                $("#tempdata").show();
                IntiateFields();
                $('#txtproCode').focus();
            }
        }
    }
    function SaveDVoucher() {
        var date = $('#comDate').val();
        if (date == "" || date == null)
        {
            alert("Date can not be null");
        }
        else {
            var supid= $('#ddlTitlesup').val();
            var supname= $("#ddlTitlesup option:selected").text();
            var purid= $('#ddlTitlepur').val();
            var purname= $("#ddlTitlepur option:selected").text();
            if ((supid == "" || supid == null || supname == "" || supname == null))
            {
                alert("Supplier account can not be empty or null");
            }
        else{
        var rowCount = $('#mytable tbody tr').length;
        if (rowCount <= 0) {
            alert("Must have rows to save.")
        }
        else {
            var answer = confirm("Do You really want to Save this?");
            if (answer) {
                $('#btnSave').disable(true);
                var date = $('#comDate').val();
                var vid = $('#compno').val();
                //if (vid == "" || vid == null) {
                //    vid = $('#ddlTitleinv').val();
                //}
                var detail = [];
                var totalquantity = 0;
                $('#mytable tbody tr').each(function () {
                    var $row = $(this), $tds = $row.find("td");
                    totalquantity += parseFloat($tds[2].innerText);
                    detail.push({
                        accCode: $tds[0].innerText,
                        title: $tds[1].innerText,                        
                        box: $tds[2].innerText,
                        piece: $tds[3].innerText,
                        rate: $tds[4].innerText,
                        amount: $tds[5].innerText
                    });
                });
                var model = {
                    vid: vid,
                    comdate: date,
                    yourinvoice: $('#invono').val(),
                    yourdate: $('#youDate').val(),
                    supid: $('#ddlTitlesup').val(),
                    supname: $("#ddlTitlesup option:selected").text(),
                    purid: $('#ratecalc').val(),
                    purname: $('#milltype').val(),
                    discount: $('#txtbrorate').val(),
                    nettotal: $('#nettotal').val(),
                    store: $('#mode').val(),
                    totalquantity:totalquantity,
                    isupdate: IsUpdate,
                    isprint: IsPrintJV,
                    detail: detail
                };
                //  alert(JSON.stringify(model));
                $.ajax({
                    url: "/PurchaseOrder/SaveInvoice",
                    type: "POST",
                    data: JSON.stringify({ model: model }),
                    dataType: 'text json',
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        if (response != null && response.success) {
                            alert(response.responseText);
                            //$('#txtVochNo').val(response.responseText.toString());
                            //$('#txtAccCode').disable(false);
                            //$('#ddlTitle').disable(false);
                            //$('#txtDebit').disable(false);
                            //$('#txtCredit').disable(false);
                            //$('#txtNarration').disable(false);
                            //$("#txtAccCode").focus();
                            //$('#btnSave').show();
                            //$('#btnSearch').hide();
                            if (IsPrintJV) {
                                //alert("hurrah");
                                var string = "rtype=rptPurchaseInvoice" + "&txtAccCode=" + vid + "";
                                var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
                                window.open(url, "_blank");
                            }
                            window.location.reload();
                        }
                        else {
