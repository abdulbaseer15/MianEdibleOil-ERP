<div id="content">
    <div class="row">
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <b>Chart of Account</b>
                </div>
                <div class="card-body" style="overflow-y: auto; max-height: calc(100vh - 205px);">
                    @{ Html.RenderAction("_AccountTree", "Accounts"); }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <form id="frmSave" action="AccountCoding" method="Post" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <b>Account Detail</b>
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="IsUpdate" id="IsUpdate" value="" />
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Selected Code</label>
                                    <input type="text" class="form-control form-control-sm" id="Nature" name="Nature" readonly="true" placeholder="Selected Code" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Account Code</label>
                                    <input type="number" class="form-control form-control-sm" id="AccountId" name="AccountId" readonly="true" placeholder="Account Code" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Level</label>
                                    <input type="text" class="form-control form-control-sm" id="LevelKey" name="LevelKey" readonly="true" placeholder="Level" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Title</label>
                                    <input type="text" class="form-control form-control-sm" id="Title" name="Title" placeholder="Title" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Contact Person</label>
                                    <input type="text" class="form-control form-control-sm" id="ContactPerson" name="ContactPerson" placeholder="Contact Person" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sales Tax No</label>
                                    <input type="text" class="form-control form-control-sm" id="SalesTaxNo" name="SalesTaxNo" placeholder="Sales Tax" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Phone No</label>
                                    <input type="text" class="form-control form-control-sm" id="PhoneNo" name="PhoneNo" placeholder="Phone" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>City</label>
                                    @{List<SelectListItem> Cities = new List<SelectListItem>();
                                        foreach (var city in ViewBag.Cities)
                                        {
                                            Cities.Add(new SelectListItem
                                            {
                                                Text = city.CityName,
                                                Value = Convert.ToString(city.CityId)
                                            });
                                        }
                                    }
                                    @Html.DropDownListFor(u => u.CityId, Cities, new { id = "ddlCity", name = "ddlCity", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Sales Discount</label>
                                    <input type="number" class="form-control form-control-sm" id="SalesDiscount" name="SalesDiscount" placeholder="Sales Discount" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="">
                                    <label>Address</label>
                                    <input type="text" class="form-control form-control-sm" id="Address" name="Address" placeholder="Adress" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="" style="margin-top: 15px;">
                                    <label>Is Party  &nbsp; </label>
                                   
                                    <input type="checkbox" value="True" checked class="" id="cbxIsParty" name="IsParty" style="width: 20px; height: 20px; vertical-align: sub;" />
                                 
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-3">
                                <button type="submit" id="btnNew" class="btn btn-primary btn-block" onclick='NewClicked();'>New</button>
                                <button type="submit" id="btnSave" class="btn btn-success" onclick='SaveAccount();'>Save</button>
                            </div>
                            <div class="col-xs-6 col-md-3">
                                <input type="button" id="btnDelete" value="Delete" class="btn btn-danger btn-block" onclick='DeleteClicked();'>
                            </div>
                            <div class="col-xs-6 col-md-3">
                                <input type="button" value="Search" id="btnSearch" class="btn btn-default btn-block" onclick='SearchClicked();' />
                                <input type="button" id="btnGo" value="Go" class="btn btn-success" onclick='SearchAccount();'>
                            </div>
                            <div class="col-xs-6 col-md-3">
                                <input type="button" id="btnClose" value="Clear" class="btn btn-success btn-block" onclick='ClearClicked();'>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>