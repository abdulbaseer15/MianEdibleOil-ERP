@model ApnaAccountWeb.Models.Account
<script src="~/Content/js/jquery.min.js"></script>
<script type="text/javascript">
    var ParentId;
    var Nature;
    var newUrl = '@Url.Action("AccountCoding","Accounts")';
    var isNew = false;
    var isUpdating = false;
    $(document).ready(function () {
        $.fn.extend({
            disable: function (state) {
                return this.each(function ()
                {
                    this.disabled = state;
                });
            }
        });
        $('#btnDelete').disable(true);
        $('#ddlAType').disable(true);
        $('#btnSave').hide();
        $('#btnGo').hide();
    });
    function NewClicked()
    {
        isNew = true;
        isUpdating = false;
        $('#IsUpdate').val('0');
        //$('#btnSave').show();
        //$('#btnNew').disable(true);
        $('#btnGo').hide();
        $('#btnNew').disable(true);
    }
    function ClearClicked() {
        window.location.href = '@Url.Action("AccountCoding", "Accounts")';
    }
    function SelectedAccount(id,title,Type)
    {
        if (!isNew) {
            $('#AccountId').val(id);
            SearchAccount();
        }
        if (!isNew && !isUpdating)
        {
            $('#Nature').val(id + " " + title);
           // alert("ok");
            //if (isNew = false)
            //{
             //   alert("ok2");
                //$('#AccountId').val(id);
                //SearchAccount();
           // }
        }
    }
    function NewAccount(id,name,title)
    {
        if (!isUpdating)
        {
            $('#Nature').val(id + " " + title);
        }
        if (isNew)
            {
            var Level = +name + +1;
            ParentId = id;
            Nature = id.substring(0, 1);
            if (Level >= 4) {
                $('#ddlAType').disable(false);
            }
            else
            {
                $('#ddlAType').disable(true);
            }
      $.ajax({
          url: "/Accounts/NewAccount",
          type: "POST",
          data: JSON.stringify({ strAccountId: id }),
          dataType: 'text json',
          async: false,
          contentType: 'application/json; charset=utf-8',
          success: function (response) {
              if (response != null && response.success) {
                  if (response.id == "02") {
                      alert(response.responseText.toString());
                 }
                  else {
                      $('#AccountId').val(response.responseText.toString());
                      $('#LevelKey').val(Level);
                      $("#Title").focus();
                      $('#btnSave').show();
                      $('#btnSearch').hide();
                  }
              }
              else {
                  alert(response.responseText);
              }
          },
          error: function (response) {
              alert(response.responseText);
          }
      });
     }
    }
