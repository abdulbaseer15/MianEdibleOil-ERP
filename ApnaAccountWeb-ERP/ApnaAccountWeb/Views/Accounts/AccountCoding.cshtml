        //    url: "/Account/Account",
        //    type: "POST",
        //    data: JSON.stringify(Account),
        //    dataType: 'text json',
        //    async: false,
        //    contentType: 'application/json; charset=utf-8',
        //    success: function (response) {
        //        debugger
        //        if (response != null && response.success)
        //        {
        //            isNew = false;
        //            alert(response.responseText);
        //            window.location.href = newUrl;
        //        }
        //        else
        //        {
        //            alert(response.responseText);
        //        }
        //    },
        //    error: function (response) {
        //        alert("Failed!");
        //    }
        //});
    }
    function SearchAccount()
    {
        isNew = false;
        isUpdating = true;
        $('#IsUpdate').val('1');
        $.ajax({
            url: "/Accounts/SearchAccount",
            type: "POST",
            data: JSON.stringify({ strAccountId: $('#AccountId').val()}),
            dataType: "json",
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                if (response != null)
                {
                  
                    $('#btnSave').show();
                    $('#btnGo').hide();
                    $('#AccountId').prop('readonly', true);
                    $('#btnDelete').disable(false);
                    //alert(parseFloat(response.SalesDiscount.toString().trim()))
                    $('#SalesDiscount').val(response.SalesDiscount);
                    $('#AccountId').val(response.AccountId.toString().trim());
                    $('#Title').val(response.Title.toString().trim());
                    $('#ddlAType').val(response.AccType.toString().trim());
                    $('#Nature').val(response.ParentId.toString().trim());
                    $('#LevelKey').val(response.LevelKey.toString().trim());
                    if (response.LevelKey >= 4)
                    {
                        $('#ddlAType').disable(false);
                    }
                    debugger;
                    if (response.Address == null) {
                        $('#Address').val(' ');
                    }
                    else {
                        $('#Address').val(response.Address.toString());
                    }
                    if (response.PhoneNo == null) {
                        $('#PhoneNo').val(' ');
                    }
                    else {
                        $('#PhoneNo').val(response.PhoneNo.toString());
                    }
                    if (response.ContactPerson == null) {
                        $('#ContactPerson').val(' ');
                    }
                    else {
                        $('#ContactPerson').val(response.ContactPerson.toString());
                    }
                    if (response.SalesTaxNo == null) {
                        $('#SalesTaxNo').val(' ');
                    }
                    else {
                        $('#SalesTaxNo').val(response.SalesTaxNo.toString());
                    }
                    if (response.CityId == null) {
                        $('#ddlCity').val(' ');
                    }
                    else {
                        $('#ddlCity').val(response.CityId.toString());
                    }

                    if (response.IsParty) {
                        $('#cbxIsParty').prop('checked', true);
                    }
                    else {
                        $('#cbxIsParty').prop('checked', false);
                    }
                    $('#txtFaxNo').val(response.FaxNo.toString().trim());
                }
                else
                {
                    alert("!No Record Found");
                }
            },
            error: function (response)
            {
                alert(response.responseText);
            }
        });
    }
    function SearchClicked()
    {
        $('#btnGo').show();
        $('#btnSearch').hide();
        $('#AccountId').prop('readonly', false);
        $("#AccountId").focus();
        $('#btnNew').disable(true);
        isNew = false;
        isUpdating = true;
        $('#IsUpdate').val('1');
    }
    function DeleteClicked()
    {
        var answer = confirm("Are you sure you want to delete this account?");
        if (answer)
        {
            $.ajax({
                url: "/Accounts/DeleteAccount",
                type: "POST",
                data: JSON.stringify({ strAccountId: $('#AccountId').val()}),
                dataType: 'text json',
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response != null && response.success)
                    {
                        window.location.href = newUrl;
                    } else {
                        alert(response.responseText);
                    }
                },
                error: function (response)
                {
                    alert(response.responseText);
                }
            });
        }
    }
</script>
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
