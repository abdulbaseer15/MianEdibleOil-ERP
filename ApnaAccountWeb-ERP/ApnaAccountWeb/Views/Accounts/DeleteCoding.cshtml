@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span6">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Chart of Account</h5>
                        </div>
                        <div class="widget-content nopadding">
                            @{ Html.RenderAction("_AccountTree", "Accounts"); }
                        </div>
                    </div>
                </div>
                <div class="span6">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Account Detail</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form action="DeleteCoding" method="Post" enctype="multipart/form-data" class="form-horizontal">
                                <div class="control-group">
                                    <label class="control-label">Selected Code:</label>
                                    <div class="controls">
                                        <input type="text" class="span11" id="Nature" name="Nature" readonly="true" placeholder="Selected Code" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button type="submit" id="btnNew" class="btn btn-danger">Delete</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}
@if (1 == 1)
{
    <div id="content">
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">
                        <b>Chart of Account</b>
                    </div>
                    <div class="card-body" style="overflow-y: auto; max-height: calc(100vh - 190px);">
                        @{ Html.RenderAction("_AccountTree", "Accounts"); }
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card">
                    <div class="card-header">
                        <b>Account Detail</b>
                    </div>
                    <div class="card-body">
                        <form action="DeleteCoding" method="Post" enctype="multipart/form-data" class="form-horizontal">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Selected Code:</label>
                                        <input type="text" class="form-control form-control-sm" id="Nature" name="Nature" readonly placeholder="Selected Code" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-2">
                                    <button type="submit" id="btnNew" class="btn btn-sm btn-danger">Delete</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
