<script>
    $(document).ready(function () {
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        $(".debit").change(function () {
            var count = 0;
            $('#mytable tbody tr').each(function () {
                var $row = $(this), $tds = $row.find("td");
                var t1debit = parseFloat($('.debit', this).val());
                if (isNaN(t1debit))
                    t1debit = 0;
                count = count + t1debit;
            });
            document.getElementById('sumdebit').innerHTML = "Total debit:" + count;
        });
        $(".credit").change(function () {
            var count = 0;
            $('#mytable tbody tr').each(function () {
                var $row = $(this), $tds = $row.find("td");
                var t1debit = parseFloat($('.credit', this).val());
                if (isNaN(t1debit))
                    t1debit = 0;
                count = count + t1debit;
            });
            document.getElementById('sumcredit').innerHTML = "Total credit:" + count;
        });
    });
