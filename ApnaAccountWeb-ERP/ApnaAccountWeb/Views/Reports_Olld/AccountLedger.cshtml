@model ApnaAccountWeb.ViewModels.VViewModel
<script src="~/Content/js/jquery.min.js"></script> 
<script src="~/Content/Datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $('#txtAccCode').focus();
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        $('#dtpDatefrom').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpDatefrom').datepicker('setDate', 'now');
        $('#dtpDateto').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtAccCode').keypress(function (e) {
            if (e.which == 13) {
                $('#myModal').modal('show');
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                $('#tblPopup tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    var val = $('#txtAccCode').val();
                    val = val.replace(/\s/g, '');
                    $('#txtAccCode').val(val);
                    $('#ddlTitle').val(val);
                    $('#ddlTitle').focus();
                    $('#myModal').modal('hide');
                });
            }
        });
    });
    function ViewClicked() {
        var excel = "No";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var e = document.getElementById("ddlTitle");
        var title = e.options[e.selectedIndex].text;
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&excel=" + excel + "&title=" + title + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var e = document.getElementById("ddlTitle");
        var title = e.options[e.selectedIndex].text;
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&excel=" + excel + "&title=" + title + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
<div id="content">
  <div class="container-fluid">
    <div class="row-fluid">
        <div class="span3">
            </div>
         <div class="span5">
        <div class="widget-box">
          <div class="widget-title"> <span class="icon"> <i class="icon-align-justify"></i> </span>
            <h5>Accounts Ledger Report</h5>
          </div>
          <div class="widget-content nopadding">
             <form action="Report" id="frmSave" method="Post" enctype="multipart/form-data" class="form-horizontal" >
                 <input type="hidden" id="rtype" name="rtype" value="rptAccountLedger" />
                  <input type="hidden" id="title" name="title" />
                 <div class="control-group">
                <label class="control-label">Code:</label>
                <div class="controls">
                  <input type="text" class="span11" id="txtAccCode" name="txtAccCode" data-toggle="tooltip"  title="Press enter and select account code"   />
                </div>
              </div>
              <div class="control-group">
                <label class="control-label">Title:</label>
                <div class="controls">
                   @{List<SelectListItem> AccCodelist = new List<SelectListItem>();
                          foreach (var Acc in ViewBag.AccCodeDetails)
                          {
                              AccCodelist.Add(new SelectListItem
                              {
                                  Text =Acc.Title,
                                  Value =Acc.AccountId,
                              });
                          }
                          }
                          @Html.DropDownListFor(u => u.AccTitle, AccCodelist, "-- Select Account --", new { id = "ddlTitle",Name="ddlTitle", @class = "span11 ddl" })
                </div>
              </div>
                  <div class="control-group">
                <label class="control-label">From:</label>
                <div class="controls">
                  <input type="text" class="span11 datepicker" id="dtpDatefrom" name="dtpDatefrom" />
                </div>
              </div>
                  <div class="control-group">
                <label class="control-label">To:</label>
                <div class="controls">
                  <input type="text" class="span11 datepicker" id="dtpDateto" name="dtpDateto" />
                </div>
              </div>
              <div class="form-actions">
                <input type="button" value="View" id="btnSearch" class="btn btn-success" onclick='ViewClicked();'/>
                  <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-success" style="background-color: #062f70" onclick='ExportExcel();'>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div><hr>
  </div>
</div>
 <div id="myModal" class="modal hide">
              <div class="modal-header">
                <button data-dismiss="modal" class="close" type="button">×</button>
                <h3>Search Account</h3>
              </div>
              <div class="modal-body">
        <div class="container-fluid">
    <div class="row-fluid">
      <div class="span12">
          <div class="widget-box">
          <div class="widget-title">
             <span class="icon"><i class="icon-th"></i></span> 
            <h5>Accounts List</h5>
               <input type="text" id="myInput" onkeyup="myFunction()" placeholder="Search for title.." style="float:right;">
          </div>
          <div class="widget-content nopadding">
            <table id="tblPopup" class="table table-bordered data-table">
              <thead>
                <tr>
                  <th>AccountCode</th>
                  <th>Title</th>
                </tr>
              </thead>
              <tbody>
                    @foreach (var Acc in ViewBag.AccCodeDetails)
            {
                <tr>
                    <td>@Acc.AccountId</td>
                    <td>@Acc.Title</td>
                </tr>
            }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>   
            </div>
</div>
<script>
    function myFunction() {
        var input, filter, table, tr, td, i;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("tblPopup");
        tr = table.getElementsByTagName("tr");
        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[1];
            if (td) {
                if (td.innerHTML.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
               