@if (1 == 1)
{
    <div id="content">
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">
                        <b>Party Ledger Summary Report</b>
                    </div>
                    <div class="card-body">
                        <form action="Report" id="frmSave" method="Post" enctype="multipart/form-data" class="form-horizontal">
                            <input type="hidden" id="rtype" name="rtype" value="rptPartyLedgerSummary" />
                            <input type="hidden" id="title" name="title" />
                            <div class="row">
