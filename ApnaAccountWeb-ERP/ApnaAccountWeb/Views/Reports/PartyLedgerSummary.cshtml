                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-2">
                                    <input type="button" value="View" id="btnSearch" class="btn btn-sm btn-success" onclick='ViewClicked();' />
                                </div>
                                <div class="col-md-6 col-sm-6 col-10">
                                    <div class="text-right">
                                        <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-sm btn-primary" onclick='ExportExcel();'>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div id="myModal" class="modal hide">
    <div class="modal-header">
        <button data-dismiss="modal" class="close" type="button">×</button>
        <h3>Search Account</h3>
    </div>
    <div class="modal-body">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span12">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"><i class="icon-th"></i></span>
                            <h5>Accounts List</h5>
                            <input type="text" id="myInput" onkeyup="myFunction()" placeholder="Search for title.." style="float:right;">
                        </div>
                        <div class="widget-content nopadding">
                            <table id="tblPopup" class="table table-bordered data-table">
                                <thead>
                                    <tr>
                                        <th>AccountCode</th>
                                        <th>Title</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var Acc in ViewBag.AccCodeDetails)
                                    {
                                        <tr>
                                            <td>@Acc.AccountId</td>
                                            <td>@Acc.Title</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function myFunction() {
        var input, filter, table, tr, td, i;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("tblPopup");
        tr = table.getElementsByTagName("tr");
        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[1];
            if (td) {
                if (td.innerHTML.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dtpDatefrom').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDateto').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDatefromIcon').click(function () {
                $('#dtpDatefrom').datepicker('show');
            });
            $('#dtpDatetoIcon').click(function () {
                $('#dtpDateto').datepicker('show');
            });
            $('#dtpDatefrom').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDatefrom').datepicker('setDate', 'now');

            $('#dtpDateto').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDateto').datepicker('setDate', 'now');
        });
    </script>
}
