@model ApnaAccountWeb.ViewModels.VViewModel
<script src="~/Content/js/jquery.min.js"></script>
<script src="~/Content/Datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $('#txtAccCode').focus();
        $('#cod').hide();
        $('#tit').hide();
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpDatefrom').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDatefrom').datepicker('setDate', 'now');
        //$('#dtpDateto').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('input:radio[name="radios"]').change(function () {
            if ($(this).val() == '3' || $(this).val() == '4')
            {
                $('#cod').show();
                $('#tit').show();
                $('#txtAccCode').focus();
            } else
            {
                $('#cod').hide();
                $('#tit').hide();
            }
        });
        $('#txtAccCode').keypress(function (e) {
            if (e.which == 13) {
                $('#myModal').modal('show');
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                $('#tblPopup tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    var val = $('#txtAccCode').val();
                    val = val.replace(/\s/g, '');
                    $('#txtAccCode').val(val);
                    $('#ddlTitle').val(val);
                    $('#ddlTitle').focus();
                    $('#myModal').modal('hide');
                });
            }
        });
    });
    function ViewClicked() {
        var excel = "No";
        var supres = "";
        if ($('#wv').is(":checked")) {
            supres = "ARO";
        }
        else if ($('#wv1').is(":checked")) {
            supres = "APO";
        }
        else if ($('#wv2').is(":checked")) {
            supres = "ARS";
        }
        else if ($('#wv3').is(":checked")) {
            supres = "APS";
        }
        var dtpDateto = $('#dtpDateto').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var e = document.getElementById("ddlTitle");
        var title = e.options[e.selectedIndex].text;
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDateto=" + dtpDateto + "&dtpDatefrom=" + supres + "&txtAccCode=" + txtAccCode + "&title=" + title + "&excel=" + excel + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
     var supres = "";
     if ($('#wv').is(":checked")) {
         supres = "ARO";
     }
     else if ($('#wv1').is(":checked")) {
         supres = "APO";
     }
     else if ($('#wv2').is(":checked")) {
         supres = "ARS";
     }
     else if ($('#wv3').is(":checked")) {
         supres = "APS";
     }
     var dtpDateto = $('#dtpDateto').val();
     var txtAccCode = $('#txtAccCode').val();
     txtAccCode = txtAccCode.replace(/\s/g, '');
     //var title = $('#title').val();
     var e = document.getElementById("ddlTitle");
     var title = e.options[e.selectedIndex].text;
     var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDateto=" + dtpDateto + "&dtpDatefrom=" + supres + "&txtAccCode=" + txtAccCode + "&title=" + title + "&excel=" + excel + "";
     var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
     window.open(url, "_blank");
 }
</script>
@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span3">
                </div>
                <div class="span5">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Aging Report</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form action="Report" id="frmSave" method="Post" enctype="multipart/form-data" class="form-horizontal">
                                <input type="hidden" id="rtype" name="rtype" value="rptAging" />
                                <input type="hidden" id="title" name="title" />
                                <div class="control-group">
                                    <label class="control-label">Select Report</label>
                                    <div class="controls">
                                        <label>
                                            <input type="radio" name="radios" id="wv" value="1" checked />
                                            Aging Receiveable over all
                                        </label>
                                        <label>
                                            <input type="radio" name="radios" id="wv1" value="2" />
                                            Aging Payable over all
                                        </label>
                                        <label>
                                            <input type="radio" name="radios" id="wv2" value="3" />
                                            Aging Receiveable Selected
                                        </label>
                                        <label>
                                            <input type="radio" name="radios" id="wv3" value="4" />
                                            Aging Payable Selected
                                        </label>
                                    </div>
                                </div>
                                <div class="control-group" id="cod">
                                    <label class="control-label">Code:</label>
                                    <div class="controls">
                                        <input type="text" class="span11" id="txtAccCode" name="txtAccCode" data-toggle="tooltip" title="Press enter and select account code" />
                                    </div>
                                </div>
                                <div class="control-group" id="tit">
                                    <label class="control-label">Title:</label>
                                    <div class="controls">
                                        @{List<SelectListItem> AccCodelist = new List<SelectListItem>();
                                            foreach (var Acc in ViewBag.AccCodeDetails)
                                            {
                                                AccCodelist.Add(new SelectListItem
                                                {
                                                    Text = Acc.Title,
                                                    Value = Acc.AccountId,
                                                });
                                            }
                                        }
                                        @Html.DropDownListFor(u => u.AccTitle, AccCodelist, "-- Select Account --", new { id = "ddlTitle", Name = "ddlTitle", @class = "span11 ddl" })
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">To:</label>
                                    <div class="controls">
                                        <input type="text" class="span11 datepicker" id="dtpDateto" name="dtpDateto" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <input type="button" value="View" id="btnSearch" class="btn btn-success" onclick='ViewClicked();' />
                                    <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-success" style="background-color: #062f70" onclick='ExportExcel();'>

                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}
