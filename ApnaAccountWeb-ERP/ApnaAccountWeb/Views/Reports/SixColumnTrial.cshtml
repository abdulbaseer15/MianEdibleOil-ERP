@model ApnaAccountWeb.ViewModels.VViewModel
<script src="~/Content/js/jquery.min.js"></script>
<script src="~/Content/Datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpDatefrom').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDatefrom').datepicker('setDate', 'now');
        //$('#dtpDateto').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtAccCode').keypress(function (e) {
            debugger;
            if (e.which == 13) {
                $('#myModal').modal('show');
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                $('#tblPopup tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    $('#ddlTitle').val($tds[0].innerText);
                    $('#ddlTitle').focus();
                    $('#myModal').modal('hide');
                });
            }
        });
    });
    function ViewClicked() {
        var excel = "No";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        //var title = $('#title').val();
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&excel=" + excel + "&dtpDateto=" + dtpDateto + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        //var title = $('#title').val();
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&excel=" + excel + "&dtpDateto=" + dtpDateto + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span3">
                </div>
                <div class="span5">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Six Column Trial Report</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form action="Report" id="frmSave" method="Post" enctype="multipart/form-data" class="form-horizontal">
                                <input type="hidden" id="rtype" name="rtype" value="rptSixColumnTrial" />
                                <input type="hidden" id="title" name="title" />
                                <div class="control-group">
                                    <label class="control-label">From:</label>
                                    <div class="controls">
                                        <input type="text" class="span11 datepicker" id="dtpDatefrom" name="dtpDatefrom" />
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">To:</label>
                                    <div class="controls">
                                        <input type="text" class="span11 datepicker" id="dtpDateto" name="dtpDateto" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <input type="button" value="View" id="btnSearch" class="btn btn-success" onclick='ViewClicked();' />
                                    <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-success" style="background-color: #062f70" onclick='ExportExcel();'>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}
@if (1 == 1)
{
    <div id="content">
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">
                        <b>Six Column Trial Report</b>
                    </div>
                    <div class="card-body">
                        <form action="Report" id="frmSave" method="Post" enctype="multipart/form-data" class="form-horizontal">
                            <input type="hidden" id="rtype" name="rtype" value="rptSixColumnTrial" />
                            <input type="hidden" id="title" name="title" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>From:</label>
                                        <div class="input-group date" data-target-input="nearest">
                                            <input type="text" class="form-control form-control-sm" id="dtpDatefrom" name="dtpDatefrom" />
                                            <div class="input-group-append" id="dtpDatefromIcon" data-target="#dtpDatefrom" data-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>To:</label>
                                        <div class="input-group date" data-target-input="nearest">
                                            <input type="text" class="form-control form-control-sm" id="dtpDateto" name="dtpDateto" />
                                            <div class="input-group-append" id="dtpDatetoIcon" data-target="#dtpDateto" data-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-2">
                                    <input type="button" value="View" id="btnSearch" class="btn btn-sm btn-success" onclick='ViewClicked();' />
                                </div>
                                <div class="col-md-6 col-sm-6 col-10">
                                    <div class="text-right">
                                        <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-sm btn-primary" onclick='ExportExcel();'>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dtpDatefrom').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDateto').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDatefromIcon').click(function () {
                $('#dtpDatefrom').datepicker('show');
            });
            $('#dtpDatetoIcon').click(function () {
                $('#dtpDateto').datepicker('show');
            });
            $('#dtpDatefrom').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDatefrom').datepicker('setDate', 'now');

            $('#dtpDateto').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDateto').datepicker('setDate', 'now');
        });
    </script>
}    