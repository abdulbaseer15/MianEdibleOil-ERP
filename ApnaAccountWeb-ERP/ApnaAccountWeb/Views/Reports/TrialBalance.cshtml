@model ApnaAccountWeb.ViewModels.VViewModel
<script src="~/Content/js/jquery.min.js"></script>
<script src="~/Content/Datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpTDate').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpTDate').datepicker('setDate', 'now');
    });
    function ViewClicked() {
        var excel = "No";
        var tdate = $('#dtpTDate').val();
        var sort = $("input[name='radios']:checked").val();
        var string = "rtype=rptTrialBalance" + "&dtpDatefrom=" + tdate + "" + "&excel=" + excel + "&title=" + sort + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var tdate = $('#dtpTDate').val();
        var sort = $("input[name='radios']:checked").val();
        var string = "rtype=rptTrialBalance" + "&dtpDatefrom=" + tdate + "" + "&excel=" + excel + "&title=" + sort + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span4">
                </div>
                <div class="span6">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Trial Balance</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form enctype="multipart/form-data" class="form-horizontal">
                                @*<table class="table table-bordered data-table">
                                        <tr>
                                            &nbsp;&nbsp;To Date
                                            <td><input type="text" class="datepicker" id="dtpTDate" name="dtpTDate" /></td>
                                        </tr>
                                    </table>*@
                                <div class="control-group">
                                    <label class="control-label">To Date :</label>
                                    <div class="controls">
                                        <input type="text" class="datepicker" id="dtpTDate" name="dtpTDate" />
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Sort by</label>
                                    <div class="controls">
                                        <label>
                                            <input type="radio" name="radios" value="Title" />
                                            Title
                                        </label>
                                        <label>
                                            <input type="radio" name="radios" checked value="Code" />
                                            Account code
                                        </label>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button id="btnView" class="btn btn-primary" style="margin-left:-60px" onclick='ViewClicked();'>View</button>
                                    <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-success" style="background-color: #062f70" onclick='ExportExcel();'>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}
@if (1 == 1)
{
    <div id="content">
        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">
                        <b>Trial Balance</b>
                    </div>
                    <div class="card-body">
                        <form enctype="multipart/form-data" class="form-horizontal">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>To Date:</label>
                                        <div class="input-group date" data-target-input="nearest">
                                            <input type="text" class="form-control form-control-sm" id="dtpTDate" name="dtpTDate" />
                                            <div class="input-group-append" id="dtpTDateIcon" data-target="#dtpTDate" data-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <b>Sort by:</b>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <div class="custom-control custom-radio">
                                            <input class="custom-control-input" type="radio" id="wv" checked name="radios" value="Title">
                                            <label for="wv" class="custom-control-label">Title</label>
                                        </div>
                                        <div class="custom-control custom-radio">
                                            <input class="custom-control-input" type="radio" id="wmr" name="radios" value="Code">
                                            <label for="wmr" class="custom-control-label">Account code</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-2">
                                    <button id="btnView" class="btn btn-sm btn-primary" onclick='ViewClicked();'>View</button>
                                </div>
                                <div class="col-md-6 col-sm-6 col-10">
                                    <div class="text-right">
                                        <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-sm btn-success" onclick='ExportExcel();'>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dtpTDate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDateto').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpTDateIcon').click(function () {
                $('#dtpTDate').datepicker('show');
            });
            $('#dtpDatetoIcon').click(function () {
                $('#dtpDateto').datepicker('show');
            });
            $('#dtpDatefrom').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDatefrom').datepicker('setDate', 'now');

            $('#dtpDateto').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDateto').datepicker('setDate', 'now');
        });
    </script>
}  