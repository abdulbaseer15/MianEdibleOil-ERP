@model ApnaAccountWeb.ViewModels.VViewModel
<script src="~/Content/js/jquery.min.js"></script>
<script src="~/Content/Datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        $('#dtpTDate').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpTDate').datepicker('setDate', 'now');
    });
    function ViewClicked() {
        var excel = "No";
        var tdate = $('#dtpTDate').val();
        var sort = $("input[name='radios']:checked").val();
        var string = "rtype=rptBalanceSheet" + "&dtpDateto=" + tdate + "" +  "&excel=" + excel+"&title=" + sort + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var tdate = $('#dtpTDate').val();
        var sort = $("input[name='radios']:checked").val();
        var string = "rtype=rptBalanceSheet" + "&dtpDateto=" + tdate + "" + "&excel=" + excel + "&title=" + sort + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
<div id="content">
    <div class="container-fluid">
        <div class="row-fluid">
            <div class="span4">
            </div>
                <div class="span6">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Trial Balance</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form enctype="multipart/form-data" class="form-horizontal">
                                @*<table class="table table-bordered data-table">
                                    <tr>
                                        &nbsp;&nbsp;To Date
                                        <td><input type="text" class="datepicker" id="dtpTDate" name="dtpTDate" /></td>
                                    </tr>
                                </table>*@
                                 <div class="control-group">
                <label class="control-label">To Date :</label>
                <div class="controls">
                 <input type="text" class="datepicker" id="dtpTDate" name="dtpTDate" />
                </div>
              </div>
                                 <div class="control-group">
                <label class="control-label">Sort by</label>
                <div class="controls">
                  <label>
                    <input type="radio" name="radios" value="Title" />
                    Title</label>
                  <label>
                    <input type="radio" name="radios"  checked value="Code"/>
                    Account code</label>
                </div>
              </div>
                                <div class="form-actions">
                                    <button id="btnView" class="btn btn-primary" style="margin-left:-60px" onclick='ViewClicked();'>View</button>
                                    <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-success" style="background-color: #062f70" onclick='ExportExcel();'>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
    </div>
</div>
