<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        window.onload = function () {
            document.getElementById("txtOpening").focus();
        };
        $('#txtOpening').keypress(function (e) {
            if (e.which == 13)
                $('#txtClosing').focus();
        });
        $('#txtClosing').keypress(function (e) {
            if (e.which == 13)
                $('#dtpDateto').focus();
        });
        //$('#dtpDatefrom').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDatefrom').datepicker('setDate', 'now');
        //$('#dtpDateto').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtAccCode').keypress(function (e) {
            debugger;
            if (e.which == 13) {
                $('#myModal').modal('show');
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                $('#tblPopup tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    $('#ddlTitle').val($tds[0].innerText);
                    $('#ddlTitle').focus();
                    $('#myModal').modal('hide');
                });
            }
        });
    });
    function ViewClicked() {
        var Opening = $('#txtOpening').val();
        var Closing = $('#txtClosing').val();
        var dtpDateto = $('#dtpDateto').val();
        var supres = "";
        if ($('#S').is(":checked")) {
            supres = "S";
        }
        else if ($('#D').is(":checked")) {
            supres = "D";
        }
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDateto=" + dtpDateto + "" + "&title=" + supres + "&Opening=" + Opening + "&Closing=" + Closing + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var Opening = $('#txtOpening').val();
        var Closing = $('#txtClosing').val();
        var dtpDateto = $('#dtpDateto').val();
        var supres = "";
        if ($('#S').is(":checked")) {
            supres = "S";
        }
        else if ($('#D').is(":checked")) {
            supres = "D";
        }
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDateto=" + dtpDateto + "" + "&title=" + supres + "&Opening=" + Opening + "&Closing=" + Closing + "&excel=" + excel + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
