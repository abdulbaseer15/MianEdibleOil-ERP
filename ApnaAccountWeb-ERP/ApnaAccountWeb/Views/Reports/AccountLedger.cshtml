@*Code Field Modal*@
<div id="myModal" class="modal hide fade" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Search Account</h5>
                <button data-dismiss="modal" class="close" type="button">×</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <span class="icon"><i class="icon-th"></i></span>
                                <b>Accounts List</b>
                                <input type="text" class="form-control form-control-sm" id="myInput" onkeyup="myFunction()" placeholder="Search for title.." style="float:right;">
                            </div>
                            <div class="card-body">
                                <table id="tblPopup" class="table table-bordered" tabindex="-1">
                                    <thead>
                                        <tr>
                                            <th>AccountCode</th>
                                            <th>Title</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var Acc in ViewBag.AccCodeDetails)
                                        {
                                            <tr>
                                                <td>@Acc.AccountId</td>
                                                <td>@Acc.Title</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                @*<button type="button" class="btn btn-primary">Save changes</button>*@
            </div>
        </div>
    </div>
</div>
@*Code Field Modal End*@
<script>
    function myFunction() {
        var input, filter, table, tr, td, i;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("tblPopup");
        tr = table.getElementsByTagName("tr");
        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[1];
            if (td) {
                if (td.innerHTML.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dtpDatefrom').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDateto').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDatefromIcon').click(function () {
                $('#dtpDatefrom').datepicker('show');
            });
            $('#dtpDatetoIcon').click(function () {
                $('#dtpDateto').datepicker('show');
            });
            $('#dtpDatefrom').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDatefrom').datepicker('setDate', 'now');

            $('#dtpDateto').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDateto').datepicker('setDate', 'now');
        });
    </script>
}