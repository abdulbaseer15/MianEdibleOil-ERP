</style>
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    var isTrue = 0;
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $('#txtAccCode').focus();
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpDatefrom').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDatefrom').datepicker('setDate', 'now');
        //$('#dtpDateto').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtAccCode').keypress(function (e) {
            if (e.which == 13) {
                $('#myModal').modal('show');
                forOrder();
                $('#myModal').modal('show');
                $('#myModal').on('shown.bs.modal', function () {
                    $('#myInput').focus(); // Set focus once the modal is fully visible
                });
                $('.textboxSearch').focus();
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                $('#tblPopup tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    var val = $('#txtAccCode').val();
                    val = val.replace(/\s/g, '');
                    $('#txtAccCode').val(val);
                    $('#ddlTitle').val(val);
                    $('#ddlTitle').focus();
                    $('#myModal').modal('hide');
                });
            }
        });
    });


    function forOrder() {
        // debugger;
        var flag = true;
        var trows = document.getElementById('tblPopup').rows, t = trows.length, trow;
        var countrow = -1; // Initialize countrow to -1, as no rows are selected initially

        // Initialize the table rows and set up onclick event
        while (--t > -1) {
            trow = trows[t];
            trow.className = 'normal';
            trow.onclick = highlightRow;
        }

        function highlightRow(gethighlight) {
            //debugger;
            gethighlight = gethighlight === true;
            trows = document.getElementById('tblPopup').rows, t = trows.length, trow;

            while (--t > -1) {
                trow = trows[t];
                if (gethighlight && trow.className === 'highlighted') {
                    countrow = t; // Change this to set countrow to the exact index
                    return t;
                } else if (!gethighlight && trow !== this) {
                    trow.className = 'normal';
                }
            }
            return gethighlight ? null : this.className = this.className === 'highlighted' ? 'normal' : 'highlighted';
        }

        function movehighlight(way, e) {
            //  debugger;
            var idx = highlightRow(true), nextrow;
            var filteredCount = 0; // Count of visible rows
            var startIndex = way > 0 ? idx + 1 : idx - 1; // Start from next or previous index

            for (var i = startIndex; i >= 0 && i < trows.length; i += way) {
                if (trows[i].style.display !== 'none') { // Only consider visible rows
                    filteredCount++; // Increment visible row count
                    if (filteredCount === 1) {
                        countrow = i; // Update countrow to the current row index
                        return highlightRow.apply(trows[i]); // Highlight the first visible row found
                    }
                }
            }

            // If no visible rows found, cycle to the first or last displayed row
            for (var j = way > 0 ? 0 : trows.length - 1; (way > 0 ? j < trows.length : j >= 0) ; j += (way > 0 ? 1 : -1)) {
                if (trows[j].style.display !== 'none') {
                    countrow = j; // Update countrow to the current row index
                    return highlightRow.apply(trows[j]); // Highlight the first found visible row
                }
            }
        }

        function processkey(e) {
            e = e || event;
            switch (e.keyCode) {
                case 38: { // Up Arrow
                    // debugger;
                    $('#tblPopup').focus();
                    flag = false;
                    countrow--; // Decrease countrow on keyup
                    return movehighlight(-1, e);
                }
                case 40: { // Down Arrow
                    //debugger;
                    $('#tblPopup').focus();
                    flag = true;
                    countrow++; // Increase countrow on keydown
                    return movehighlight(1, e); // Move highlight to displayed records
                }
                case 13: { // Enter Key
                    if ($("#tblPopup").is(":focus")) {
                        if (countrow >= 0) { // Ensure countrow is not negative
                            var selectedRow = trows[countrow]; // Select the highlighted row directly using countrow
                            var $tds = $(selectedRow).find("td");

                            // Fetch values from the selected row
                            $('#txtAccCode').val($tds[0].innerText); // Assuming the first column contains the code
                            $('#ddlTitle').val($tds[0].innerText); // Populate another field with the same value
                            $('#myInput').val(""); // Clear the input if needed
                            $('#myMo dal').modal('hide'); // Hide the modal
                            isTrue == 1;
                            $('#dtpDatefrom').focus(); // Set focus to another input if needed
                            countrow = -1; // Reset countrow
                            isTrue == 1;
                            return;
                        }
                    }
                    break; // Exit the switch
                }
                default: {
                    return true; // Allow other keys to function normally
                }
            }
        }

        document.onkeydown = processkey; // Set the keydown event handler
    }

    function ViewClicked() {
        debugger;
        var excel = "No";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var e = document.getElementById("ddlTitle");
        var title = encodeURIComponent(e.options[e.selectedIndex].text);
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&excel=" + excel + "&title=" + title + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var e = document.getElementById("ddlTitle");
        var title = encodeURIComponent(e.options[e.selectedIndex].text);
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&excel=" + excel + "&title=" + title + "";
        var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
@if (1 != 1)
