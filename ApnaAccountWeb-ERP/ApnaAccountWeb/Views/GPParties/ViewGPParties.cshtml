@model IEnumerable<ApnaAccountWeb.Models.PartiesGatePass>
<link rel="stylesheet" href="~/Content/css/uniform.css" />
<link rel="stylesheet" href="~/Content/css/select2.css" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
       alert("@TempData["message"]");
    </script>
}
<div id="content">
  <div class="container-fluid">
    <div class="row-fluid">
      <div class="span12">
          <a href="@Url.Action("RegisterGPParties", "GPParties", new { @class = "btn btn-primary" })" style="float:right">Add GatePass Parties </a>
        <div class="widget-box">
          <div class="widget-title">
             <span class="icon"><i class="icon-th"></i></span> 
            <h5>GatePass Parties List</h5>
          </div>
          <div class="widget-content nopadding">
            <table class="table table-bordered data-table" @*style="width:100%"*@>
              <thead>
                <tr>
                  <th>Serial</th>
                  <th>Name</th>
                    <th>Father Name</th> 
                     <th>Id Card No</th>
                    <th>Designation</th>
                  <th>Mobile No</th>
                  <th>Hom Mobile No</th>
                    <th>Address</th>
                    <th>Joining Date</th>
                     <th>Action</th>
                </tr>
              </thead>
              <tbody>
                  @{
                  int i=1;
                  }
                @foreach (var item in Model) {
                                        <tr>
                                            <td>@i</td>
                                            <td>@Html.DisplayFor(u => item.Title)</td>
                                            <td>@Html.DisplayFor(u=>item.So)</td>
                                            <td>@Html.DisplayFor(u=>item.IDcard)</td>
                                            <td>@Html.DisplayFor(u=>item.Designation)</td>
                                             <td>@Html.DisplayFor(u=>item.MobNo)</td>
                                             <td>@Html.DisplayFor(u=>item.HomeMobNo)</td>
                                            <td>@Html.DisplayFor(u => item.Remarks)</td>
                                            <td>@item.JDate.Value.ToShortDateString()</td>
                                            <td>@Html.ActionLink("Edit", "Edit", new { id = @item.CompID }) |@Html.ActionLink("Delete", "Delete", new { id = @item.CompID }) |<a href="@Url.Action("Report", "Reports", new { rtype = "GatePassParties", txtAccCode = @item.CompID })" target="_blank">Print</a></td>
                                        </tr>
                    i++;
                                        }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="~/Content/js/jquery.min.js"></script> 
<script src="~/Content/js/jquery.ui.custom.js"></script>
<script src="~/Content/js/jquery.uniform.js"></script> 
<script src="~/Content/js/select2.min.js"></script> 
<script src="~/Content/js/jquery.dataTables.min.js"></script> 
<script src="~/Content/js/maruti.js"></script>
<script src="~/Content/js/maruti.tables.js"></script>
