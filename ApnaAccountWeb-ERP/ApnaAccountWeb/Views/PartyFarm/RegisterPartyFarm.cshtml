<div id="content">
    <div class="row">
        <div class="col-md-6">
            <form action="RegisterPartyFarm" method="Post" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <b>Create Party Farm</b>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" class="form-control form-control-sm" id="Title" name="Title" required placeholder="Name" />
                        </div>
                        <div class="form-group">
                            <label>Account ID</label>
                            @{List<SelectListItem> AccCode = new List<SelectListItem>();
                                foreach (var Acc in ViewBag.AccCodelist)
                                {
                                    AccCode.Add(new SelectListItem
                                    {
                                        Text = Acc.Title,
                                        Value = Acc.AccountId,
                                    });
                                }
                            }
                            @Html.DropDownListFor(u => u.AccountID, AccCode, "-- Select Account --", new { id = "ddlTitle", @class = "form-control form-control-sm" })
                        </div>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-2">
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                            </div>
                            <div class="col-md-6 col-sm-6 col-10">
                                <div class="text-right">
                                    <a class="btn btn-sm btn-default" href="@Url.Action("ViewPartyFarm", "PartyFarm")">View Party Farm</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>