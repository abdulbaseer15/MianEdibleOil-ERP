<div id="content">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <b>Select Group</b>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Arrival Party Code</label>
                                <input type="text" class="form-control form-control-sm" id="txtsupCode" name="txtsupCode" data-toggle="tooltip" title="Press enter and select account code" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Title</label>
                                <select class="form-control form-control-sm" id="APC" name="APC">
                                    @{
                                        <option>Select Account</option>
                                        foreach (var city in ViewBag.AccCodelist)
                                        {
                                            <option value="@city.AccountID">@city.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Sale Party Code</label>
                                <input type="text" class="form-control form-control-sm" id="txtpurCode" name="txtpurCode" data-toggle="tooltip" title="Press enter and select account code" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Title</label>
                                <select class="form-control form-control-sm" id="SPC" name="SPC">
                                    @{
                                        <option>Select Account</option>
                                        foreach (var city in ViewBag.AccCodelist2)
                                        {
                                            <option value="@city.AccountID">@city.Title</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    @*@{ Html.RenderAction("_AccountTree", "Accounts"); }*@
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <form id="frmSave" action="AccountCoding" method="Post" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <b>Account Detail</b>
                    </div>
                    <div class="card-body">
                        <input type="hidden" name="IsUpdate" id="IsUpdate" value="" />
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Selected Code</label>
                                    <input type="text" class="form-control form-control-sm" id="Nature" name="Nature" readonly="true" placeholder="Selected Code" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Account Code</label>
                                    <input type="number" class="form-control form-control-sm" id="AccountId" name="AccountId" readonly="true" placeholder="Account Code" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Level</label>
                                    <input type="text" class="form-control form-control-sm" id="LevelKey" name="LevelKey" readonly="true" placeholder="Level" />
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>Title</label>
                                    <input type="text" class="form-control form-control-sm" id="Title" name="Title" placeholder="Title" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>Type</label>
                                    <select class="form-control form-control-sm" id="AccType" name="AccType">
                                        <option>Group</option>
                                        <option>Detail</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2 align-content-end">
                                <div class="form-group">
                                    <div class="icheck-primary d-inline">
                                        <input type="checkbox" id="IsParty" checked="" name="IsParty">
                                        <label for="IsParty">Is Party</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Address</label>
                                    <input type="text" class="form-control form-control-sm" id="Address" name="Address" placeholder="Adress" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Contact Person</label>
                                    <input type="text" class="form-control form-control-sm" id="ContactPerson" name="ContactPerson" placeholder="Contact Person" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Sales Tax#</label>
                                    <input type="text" class="form-control form-control-sm" id="SalesTaxNo" name="SalesTaxNo" placeholder="Sales Tax" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Phone #</label>
                                    <input type="text" class="form-control form-control-sm" id="PhoneNo" name="PhoneNo" placeholder="Phone" />
                                </div>
                            </div>
                            @*<div class="control-group">
                                    <label class="control-label">City</label>
                                    <div class="controls">
                                        @{List<SelectListItem> Cities = new List<SelectListItem>();
                                        foreach (var city in  ViewBag.Cities)
                                        {
                                            Cities.Add(new SelectListItem
                                            {
                                                Text = city.CityName,
                                                Value = Convert.ToString(city.CityId)
                                            });
                                        }
                                        }
                                    @Html.DropDownListFor(u => u., Cities, new { id = "ddlCity", @class = "ddl" })
                                    </div>
                                </div>*@
                        </div>
                        <hr />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="row">
                                    <div class="col-md-3 col-sm-3 col-6">
                                        <button type="submit" id="btnNew" class="btn btn-sm w-100 btn-primary" onclick='NewClicked();'>New</button>
                                    </div>
                                    <div class="col-md-3 col-sm-3 col-6">
                                        <button type="submit" id="btnSave" class="btn btn-sm w-100 btn-success" onclick='SaveAccount();'>Save</button>
                                        <input type="button" id="btnDelete" value="Delete" class="btn btn-sm w-100 btn-danger" onclick='DeleteClicked();'>
                                    </div>
                                    <div class="col-md-3 col-sm-3 col-6">
                                        <input type="button" value="Search" id="btnSearch" class="btn btn-sm w-100 btn-default" onclick='SearchClicked();' />
                                    </div>
                                    <div class="col-md-3 col-sm-3 col-6">
                                        <input type="button" id="btnGo" value="Go" class="btn btn-sm w-100 btn-success" onclick='SearchAccount();'>
                                        <input type="button" id="btnClose" value="Clear" class="btn btn-sm w-100 btn-success" onclick='ClearClicked();'>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
