@model ApnaAccountWeb.Models.Accounts1
<script src="~/Content/js/jquery.min.js"></script>
<script type="text/javascript">
    var ParentId;
    var Nature;
    var newUrl = '@Url.Action("AccountCoding", "PartyRegisteration")';
    var isNew = false;
    var isUpdating = false;
    $(document).ready(function () {
        $.fn.extend({
            disable: function (state) {
                return this.each(function ()
                {
                    this.disabled = state;
                });
            }
        });
        $('#btnDelete').disable(true);
        $('#ddlAType').disable(true);
        $('#btnSave').hide();
        $('#btnGo').hide();
        $('#APC').change(function () {
            var selectedVal = $('#APC option:selected').attr('value');
            $('#txtsupCode').val(selectedVal);
            var selectedText = $("#APC option:selected").text();
            NewClicked();
            //SelectedAccount(selectedVal, selectedText, 'Group')
            NewAccount(selectedVal, 5, selectedText)
        });
        $('#SPC').change(function () {
            var selectedVal = $('#SPC option:selected').attr('value');
            $('#txtpurCode').val(selectedVal);
            var selectedText = $("#APC option:selected").text();
            NewClicked();
          //SelectedAccount(selectedVal, selectedText, 'Group')
            NewAccount(selectedVal, 5, selectedText)
        });
    });
    function NewClicked()
    {
        isNew = true;
        isUpdating = false;
        $('#IsUpdate').val('0');
        //$('#btnSave').show();
        //$('#btnNew').disable(true);
        $('#btnGo').hide();
        $('#btnNew').disable(true);
    }
    function ClearClicked() {
        window.location.href = '@Url.Action("AccountCoding", "PartyRegisteration")';
    }
    function SelectedAccount(id,title,Type)
    {
        if (!isNew) {
            $('#AccountId').val(id);
            SearchAccount();
        }
        if (!isNew && !isUpdating)
        {
            $('#Nature').val(id + " " + title);
           // alert("ok");
            //if (isNew = false)
            //{
             //   alert("ok2");
                //$('#AccountId').val(id);
                //SearchAccount();
           // }
        }
    }
    function NewAccount(id,name,title)
    {
        if (!isUpdating)
        {
            $('#Nature').val(id + " " + title);
        }
        if (isNew)
        {
            var Level = +name + +1;
            ParentId = id;
            Nature = id.substring(0, 1);
            if (Level >= 4) {
                $('#ddlAType').disable(false);
            }
            else
            {
                $('#ddlAType').disable(true);
            }
      $.ajax({
          url: "/PartyRegisteration/NewAccount",
          type: "POST",
          data: JSON.stringify({ strAccountId: id }),
          dataType: 'text json',
          async: false,
          contentType: 'application/json; charset=utf-8',
          success: function (response) {
              if (response != null && response.success) {
                  if (response.id == "02") {
                      alert(response.responseText.toString());
                 }
                  else {
                      $('#AccountId').val(response.accountid.toString());
                      $('#LevelKey').val(response.lvl.toString());
                      $('#AccType').val(response.type.toString());
                      $("#Title").focus();
                      $('#btnSave').show();
                      $('#btnSearch').hide();
                      //$('#AccType').disable(true);
                  }
              }
              else {
                  alert(response.responseText);
              }
          },
          error: function (response) {
              alert(response.responseText);
          }
      });
     }
    }
    //---------------------SaveAccount-----------------------------//
