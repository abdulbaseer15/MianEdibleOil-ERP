          </div>
          <div class="widget-content nopadding">
            <form  action="DeleteCoding" method="Post" enctype="multipart/form-data" class="form-horizontal">
              <div class="control-group">
                <label class="control-label">Selected Code:</label>
                <div class="controls">
                  <input type="text" class="span11" id="Nature" name="Nature" readonly="true" placeholder="Selected Code" />
                </div>
              </div>
              <div class="form-actions">
                  <button type="submit" id="btnNew" class="btn btn-danger">Delete</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div><hr>
  </div>
</div>
