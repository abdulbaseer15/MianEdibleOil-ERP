                    BrockerageAccount: $('#txtsupCodeBrokage').val(),
                    BrockeyRate: $('#txtbrorate').val(),
                    BrockeryMode: $('#mode').val(),
                    VehcileType: $('#ddlTitlesupVeh option:selected').attr('value'),
                    freight: $('#txtFAmt').val(),
                    BagRate: $('#txtbagRate').val(),
                    bagAmount: $('#txtsub').val(),
                    TotalWeight: $('#txtTGST').val(),
                    LabourRate: $('#txtRateL').val(),
