            BagType = 0;
        }
        var quan = parseFloat($('#txtquan').val());
        var weight = $('#txtweight').val();
        var rate = parseFloat($('#txtrate').val());
        var amount = $('#txtamount').val();
        if ($('#txtproCode').val() == "" || $('#txtproCode').val() == null || $("#ddlTitlepro option:selected").text() == "-- Select Account --") {
            alert("Cant Save You Must Select Account Code");
            $('#txtproCode').focus();
        }
        else {
            if ((amount == "" || amount == null || amount == 0 || amount < 0) || (rate == "" || rate == null || rate == 0 || rate < 0)) {
                alert("Amount or rate Cannot Empty or Zero")
                $('#txtrate').focus();
            }
            else {
                i++;
                var new_row = "<tr id='row" + i + "' ><td class='accCode'>" + accCode + "</td><td class='title'>" + product + "</td><td class='unitid'>" + quan + "</td><td class='unitname'>" + weight + "</td><td class='rate'>" + rate + "</td><td class='txtexGst'>" + txtexGst + "</td><td class='txtexDiscount'>" + txtexDiscount + "</td><td class='txtGstrate'>" + txtGstrate + "</td><td class='txtGstAmount'>" + txtGstAmount + "</td> <td class='naration'>" + amount + "</td><td><span class='editrow'><a class='fa fa-edit' href='javascript: void(0);'>Edit</a></span>|<span class='deleterow'><a class='glyphicon glyphicon-trash' href=''>Delete</a></span></td></tr>";
                if (currentRow) {
                    $('#mytable').find($(currentRow)).replaceWith(new_row);
                    currentRow = null;
                }
                else {
                    $('#mytable').append(new_row);
                }
                var tamount = 0;
                var bags = 0;
                var WeightSub = 0;
                $('#mytable tbody tr').each(function () {
                    var $row = $(this), $tds = $row.find("td");
                    var t1amount = parseFloat($tds[8].innerText);
                    var t1bags = parseFloat($tds[5].innerText);
                    var t1SubWei = parseFloat($tds[6].innerText);
                    if (isNaN(t1SubWei)) {
                        t1SubWei = 0;
                    }
                    if (isNaN(t1amount)) {
                        t1amount = 0;
                    }
                    if (isNaN(t1bags)) {
                        t1bags = 0;
                    }
                    bags = bags + t1bags;
                    WeightSub = WeightSub + t1SubWei;
                    tamount = tamount + t1amount;
                });
                $('#nettotal').val(tamount);
                $('#txtsub').val(WeightSub);
                $('#txtbags').val(bags);
                $("#tempdata").show();
                IntiateFields();
                CalculateDiscount();
                $('#txtproCode').focus();
            }
        }
    }
