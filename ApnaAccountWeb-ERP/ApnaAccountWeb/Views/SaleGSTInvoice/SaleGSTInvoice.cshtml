                };
                //  alert(JSON.stringify(model));
                $.ajax({
                    url: "/SaleGSTInvoice/SaveInvoice",
                    type: "POST",
                    data: JSON.stringify({ model: model }),
                    dataType: 'text json',
                    async: false,
                    contentType: 'application/json; charset=utf-8',
