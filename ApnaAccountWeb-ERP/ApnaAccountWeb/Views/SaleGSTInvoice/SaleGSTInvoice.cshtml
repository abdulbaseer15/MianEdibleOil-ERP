    function CalculateDiscount()
    {
        var tamount = 0;
        var quantity = 0;
        var Kgs = 0;
        var txtGstrate = 0;
        var txtexGst = 0;
        var txtexDiscount = 0;
        var txtGstAmount = 0;
        var Discount = parseFloat($('#txtdiscountp1').val());
        $('#mytable tbody tr').each(function () {
            var $row = $(this), $tds = $row.find("td");
            var Quanti = parseFloat($tds[2].innerText);
            var Kg = parseFloat($tds[3].innerText);
            var Amount = parseFloat($tds[9].innerText);
            var t1GST = parseFloat($tds[8].innerText);
            var t1bags = parseFloat($tds[5].innerText);
            var discount = parseFloat($tds[6].innerText);
            if (isNaN(Amount)) {
                Amount = 0;
            }
            if (isNaN(Kg)) {
                Kg = 0;
            }
            if (isNaN(Quanti)) {
                Quanti = 0;
            }
            if (isNaN(t1GST)) {
                t1GST = 0;
            }
            if (isNaN(t1bags)) {
                t1bags = 0;
            }
            if (isNaN(discount)) {
                discount = 0;
            }
            Kgs = Kgs + Kg;
            quantity = quantity + Quanti;
            txtexDiscount = txtexDiscount + discount;
            txtexGst = txtexGst + t1bags;
            txtGstAmount = txtGstAmount + t1GST;
            tamount = tamount + Amount;
        });
        $('#txtDiscount').val(txtexDiscount);
        $('#txtGst').val(txtexGst);
        $('#txtTGST').val(txtGstAmount);
        $('#nettotal').val(tamount);
        $('#txtbags').val(quantity);
        $('#txtsub').val(Kgs);
    }
