                forOrder();
                $('#myModalpro').modal('show');
                $('#myInput3').focus();
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup3 tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                if (e.keyCode == 27) {
                    $.modal.close();
                }
                $('#tblPopup3 tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtproCode').val($tds[0].innerText);
                    $('#ddlTitlepro').val($tds[1].innerText);
                    $('#txtrate').val(parseFloat($tds[2].innerText));
                    $('#txtSMW').val($tds[3].innerText);
                    $('#txtGstrate').val($tds[4].innerText);
                    $('#txtquan').focus();
                    $('#myModalpro').modal('hide');
                    $('#myInput3').val("");
                });
            }
        });
