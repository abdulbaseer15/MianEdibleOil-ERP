            if (counter == visibleArrayLength) {
                trow = trows[arrVisible[counter - 1]];
                trow.className = 'normal';
                counter = 0;
            }
            if (visibleArrayLength == (trows.length) - 1) {
                while (--t > -1) {
                    trow = trows[t];
