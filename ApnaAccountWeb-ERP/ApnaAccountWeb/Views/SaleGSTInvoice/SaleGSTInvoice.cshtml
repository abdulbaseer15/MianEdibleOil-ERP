    function AddGridClicked() {
        var accCode = $('#txtproCode').val();
        var product = $('#ddlTitlepro').val();
        var txtGstrate      = $('#txtGstrate').val();
        var txtexGst        = $('#txtexGst').val();
        var txtexDiscount   = $('#txtexDiscount').val();
