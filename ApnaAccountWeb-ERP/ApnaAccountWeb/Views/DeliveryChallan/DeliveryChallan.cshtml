            var purid= $('#ddlTitlepur').val();
            var purname = $("#ddlTitlepur option:selected").text();
            var Address = $('#Address').val();
            if ((supid == "" || supid == null || supname == "" || supname == null) )
            {
                alert("Customer account can not be empty or null");
            }
        else{
        var rowCount = $('#mytable tbody tr').length;
        if (rowCount <= 0) {
            alert("Must have rows to save.")
        }
        else {
            var answer = confirm("Do You really want to Save this?");
            if (answer) {
                var date = $('#comDate').val();
                var vid = $('#compno').val();
                //if (vid == "" || vid == null) {
                //    vid = $('#ddlTitleinv').val();
                //}
                var detail = [];
                var totalquantity = 0;
                $('#mytable tbody tr').each(function () {
                    var $row = $(this), $tds = $row.find("td");
                    totalquantity += parseFloat($tds[4].innerText);
                    detail.push({
                        accCode: $tds[0].innerText,
                        title: $tds[1].innerText,
                        unitid: 0,
                        unit: 0,
                        box: 0,
                        piece: $tds[2].innerText,
                        rate:0,
                        amount: $tds[3].innerText
                    });
                });
                var model = {
                    vid: vid,
                    comdate: date,
                    yourinvoice:Address,
                    yourdate: 0,
                    supid: $('#ddlTitlesup').val(),
                    supname: $("#ddlTitlesup option:selected").text(),
                    purid: $('#ddlTitlepur').val(),
                    purname: $("#ddlTitlepur option:selected").text(),
                    discount: 0,
                    nettotal: 0,
                    store: $('#txtSO').val(),
                    salestax:0,
                    freight: 0,
                    totalquantity:0,
                    isupdate: IsUpdate,
                    isprint: IsPrintJV,
                    detail: detail
                };
                //  alert(JSON.stringify(model));
                $.ajax({
                    url: "/DeliveryChallan/SaveInvoice",
                    type: "POST",
                    data: JSON.stringify({ model: model }),
                    dataType: 'text json',
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        if (response != null && response.success) {
                            alert(response.responseText);
                            //$('#txtVochNo').val(response.responseText.toString());
                            //$('#txtAccCode').disable(false);
                            //$('#ddlTitle').disable(false);
                            //$('#txtDebit').disable(false);
                            //$('#txtCredit').disable(false);
                            //$('#txtNarration').disable(false);
                            //$("#txtAccCode").focus();
                            //$('#btnSave').show();
                            //$('#btnSearch').hide();
                            if (IsPrintJV) {
                                //alert("hurrah");
                                var string = "rtype=rptDeliveryChallan" + "&txtAccCode=" + vid + "";
                                var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
                                window.open(url, "_blank");
                            }
                            window.location.reload();
                        }
                        else {
                            alert(response.responseText);
                        }
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
                @* var date = $('#dtpDate').val();
            var vid = $('#txtVochNo').val();
            var string = "Date=" + date + "&ISUpdate=" + IsUpdate + "&IsPrintDV=" + IsPrintJV + "&VID=" + vid + "";
            var url = '@(Url.Action("SaveDVVoucher", "DVoucher", null, Request.Url.Scheme))?' + string
            window.location.href = url;
            IsUpdate = false;
            IsPrintJV = false;*@
                IsUpdate = false;
                IsPrintJV = false;
            }
        }
        }
    }
    }
    function PrintReport() {
        var vid = $('#compno').val();
        var date = $('#comDate').val();
        if (vid == "" || vid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var string = "rtype=rptDeliveryChallan" + "&txtAccCode=" + vid + "";
            var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
            window.open(url, "_blank");
        }
    }
    function DeleteClicked() {
        //var dvid = $('#ddlTitleinv').val();
       var dvid = $('#compno').val();
        var date = $('#comDate').val();
        if (dvid == "" || dvid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var answer = confirm("Do You really want to Delete this?");
            if (answer) {
                $('#btnSave').show();
                $('#btnGo').hide();
                IsUpdate = true;
                var string = "Date=" + date + "&DVId=" + dvid + "";
                var url = '@(Url.Action("DeleteInvoice", "DeliveryChallan", null, Request.Url.Scheme))?' + string;
                window.location.href = url;
            }
        }
    }
</script>
