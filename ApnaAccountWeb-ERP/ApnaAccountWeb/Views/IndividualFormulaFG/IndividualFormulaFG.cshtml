<div id="myModalinvoices" class="modal hide">
    <div class="modal-header">
        <button data-dismiss="modal" class="close" type="button">×</button>
        <h3>Search Invoice</h3>
    </div>
    <div class="modal-body">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span12">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"><i class="icon-th"></i></span>
                            <h5>Invoices List</h5>
                            <input type="text" id="myInputinv" onkeyup="myFunctioninv()" placeholder="Search for title.." style="float:right;">
                        </div>
                        <div class="widget-content nopadding">
                            <table id="tblPopupinv" class="table table-bordered data-table" tabindex="-1">
                                <thead>
                                    <tr>
                                        <th>Inv No</th>
                                        <th>S No</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        string dbcon = Convert.ToString(Session["con"]);
                                        ApnaAccountWeb.ViewModels.DbConection obj = new ApnaAccountWeb.ViewModels.DbConection();
                                        string condb = obj.Connect(dbcon);
                                        ApnaAccountWeb.Models.ApnaAccountEntities db = new ApnaAccountWeb.Models.ApnaAccountEntities(condb);
                                        var lstDVChilds = (from t1 in db.Process4
                                                           where t1.IType == "IF"
                                                           select new { t1.InvNo, t1.Idate, t1.Sno }).ToList();
                                        foreach (var Acc in lstDVChilds)
                                        {
                                            <tr>
                                                <td>@Convert.ToString(Acc.InvNo)</td>
                                                <td>@Acc.Sno</td>
                                                <td>@Acc.Idate.Value.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function myFunction() {
        var input, filter, table, tr, td, i;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("tblPopup");
        tr = table.getElementsByTagName("tr");
        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[1];
            if (td) {
                if (td.innerHTML.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
