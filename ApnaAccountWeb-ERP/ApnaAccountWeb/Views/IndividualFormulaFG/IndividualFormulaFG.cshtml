@section Scripts {
    <script>
        $(document).ready(function () {
            $('#comDate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#youDate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#comDateIcon').click(function () {
                $('#comDate').datepicker('show');
            });
            $('#youDateIcon').click(function () {
                $('#youDate').datepicker('show');
            });
            $('#comDate').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#comDate').datepicker('setDate', 'now');
            $('#youDate').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#youDate').datepicker('setDate', 'now');
        });
    </script>
}