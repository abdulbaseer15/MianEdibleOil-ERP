                                countrow = -1;
                                return;
                            }
                            if (flag == false) {
                                countrow = countrow - 2;
                                if (countrow < 0) {
                                    countrow = 1;
                                }
                                var row = $("tr:eq(" + countrow + ")", tblPopupinv)
                                $tds = row.find("td");
                                $('#compno').val($tds[1].innerText);
                                $('#comDate').val($tds[2].innerText);
                                $('#myModalinvoices').modal('hide');
                                $('#comDate').disable(true);
                                $('#compno').disable(true);
                                $('#myModalinvoices').modal('hide');
                                isTrue = 1;
                                //$('#invono').focus();
                                $('#btnGo').focus();
                                countrow = -1;
                                return;
                            }
                        }
                        else if (countrow == 0) {
                            var row = $("tr:eq(1)", tblPopupinv)
                            $tds = row.find("td");
                            $('#compno').val($tds[1].innerText);
                            $('#comDate').val($tds[2].innerText);
                            $('#myModalinvoices').modal('hide');
                            $('#comDate').disable(true);
