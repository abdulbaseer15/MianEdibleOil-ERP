    var isUpdating = false;
    $(document).ready(function () {
        $.fn.extend({
            disable: function (state) {
                return this.each(function ()
                {
                    this.disabled = state;
                });
            }
        });
        $('#btnDelete').disable(true);
        $('#ddlAType').disable(true);
        $('#btnSave').hide();
        $('#btnGo').hide();
        $(document).on('click', 'span.editrow', function () {
            debugger;
            //alert('ready clicked');
            $("#Nature").val($(this).closest('tr').find('td.VId2').text());
            $("#AccountId").val($(this).closest('tr').find('td.VID').text());
            $("#LevelKey").val($(this).closest('tr').find('td.Vtype').text());
            $("#Date").val($(this).closest('tr').find('td.VDate').text());
            SearchDV2();
        });
    });
    function SearchDV2() {
        debugger;
        var vid = $('#AccountId').val();
        var type = $('#LevelKey').val();
       // $('#btnSave').show();
       // $('#btnGo').hide();
        IsUpdate = true;
        $.ajax({
            type: "GET",       // make it get request instead //
            url: "/VouchersVerification/SearchVoucher2",
            data: { Vid: vid, Type: type },
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                $("#mytable2 tr").remove();
                var new_row;
                new_row = "<tr><th>VId</th><th>Type</th><th>Title</th><th>Debit</th><th>Credit</th><th>Narration</th></tr>"
                //$('#mytable tbody').append(new_row);
                $.each(result, function (i, item) {
                    new_row += "<tr id='row" + i + "' ><td class='VId'>" + item.VId + "</td><td class='Vtype'>" + item.Vtype + "</td><td class='title'>" + item.Title + "</td><td class='debit'>" + item.Debit + "</td><td class='Credit'>" + item.Credit + "</td><td class='naration'>" + item.Narration + "</td></tr>";
                    //new_row += "<tr id='row" + i + "' ><td class='VID'> <a href='/VouchersVerification/SearchVoucher2'>" + item.Vid2 + "</a></td><td class='Vtype'>" + item.Vtype + "</td><td class='Amount'>" + item.Ttldebit + "</td><td><input type='checkbox' name='vv'></td><td><span class='editrow'><a class='fa fa-edit' href='javascript: void(0);'>View Voucher</a></span></td></tr>";
                });
                $('#mytable2 tbody').append(new_row);
                $("#tempdata2").show();
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
    }
    function NewClicked()
    {
        isNew = true;
        isUpdating = false;
        $('#IsUpdate').val('0');
        //$('#btnSave').show();
        //$('#btnNew').disable(true);
        $('#btnGo').hide();
        $('#btnNew').disable(true);
    }
    function ClearClicked() {
        window.location.href = '@Url.Action("VoucherVerify", "VouchersVerification")';
    }
    function SelectedAccount(id,title,Type)
    {
        if (!isNew) {
            $('#AccountId').val(id);
            SearchAccount();
        }
        if (!isNew && !isUpdating)
        {
            $('#Nature').val(id + " " + title);
           // alert("ok");
            //if (isNew = false)
            //{
             //   alert("ok2");
                //$('#AccountId').val(id);
                //SearchAccount();
           // }
        }
    }
    function NewAccount(id,name,title)
    {
        if (!isUpdating)
        {
            $('#Nature').val(id + " " + title);
        }
        if (isNew)
            {
            var Level = +name + +1;
            ParentId = id;
            Nature = id.substring(0, 1);
            if (Level >= 4) {
                $('#ddlAType').disable(false);
            }
            else
            {
                $('#ddlAType').disable(true);
            }
      $.ajax({
          url: "/Accounts/NewAccount",
          type: "POST",
          data: JSON.stringify({ strAccountId: id }),
          dataType: 'text json',
          async: false,
          contentType: 'application/json; charset=utf-8',
          success: function (response) {
              if (response != null && response.success) {
                  if (response.id == "02") {
                      alert(response.responseText.toString());
                 }
                  else {
                      $('#AccountId').val(response.responseText.toString());
                      $('#LevelKey').val(Level);
                      $("#Title").focus();
                      $('#btnSave').show();
                      $('#btnSearch').hide();
                  }
              }
              else {
                  alert(response.responseText);
              }
          },
          error: function (response) {
              alert(response.responseText);
          }
      });
     }
    }
