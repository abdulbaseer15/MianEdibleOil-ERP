<div id="content">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <b>Search Voucher By Narration</b>
                </div>
                <div class="card-body" style="overflow-y: auto; max-height: calc(100vh - 205px);">
                    @{ Html.RenderAction("_Verify", "VouchersVerification"); }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <b>Voucher Details</b>
                </div>
                <div class="card-body">
                    <form id="frmSave" action="AccountCoding" method="Post" enctype="multipart/form-data" class="form-horizontal">
                        <input type="hidden" name="IsUpdate" id="IsUpdate" value="" />
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Selected Voucher</label>
                                    <input type="text" class="form-control form-control-sm" id="Nature" name="Nature" readonly placeholder="Selected Voucher" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Voucher ID</label>
                                    <input type="number" class="form-control form-control-sm" id="AccountId" name="AccountId" readonly placeholder="Voucher ID" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Voucher Type</label>
                                    <input type="text" class="form-control form-control-sm" id="LevelKey" name="LevelKey" readonly placeholder="Voucher Type" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Date</label>
                                    <input type="text" class="form-control form-control-sm" id="Date" name="Date" readonly placeholder="Date" />
                                </div>
                            </div>
                        </div>
                        <div id="tempdata2">
                            <table class="table table-bordered table-sm" id="mytable2">
                                <thead>
                                    <tr class="fixed-thead">
                                        <th width="10%">VId</th>
                                        <th width="10%">Type</th>
                                        <th width="30%">Title</th>
                                        <th width="10%">Debit</th>
                                        <th width="10%">Credit</th>
                                        <th width="20%">Narration</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div class="form-actions">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
