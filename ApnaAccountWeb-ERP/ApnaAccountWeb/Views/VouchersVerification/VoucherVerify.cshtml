    function SearchAccount()
    {
        debugger;
        isNew = false;
        isUpdating = true;
        $('#IsUpdate').val('1');
        $.ajax({
            url: "/Accounts/SearchAccount",
            type: "POST",
            data: JSON.stringify({ strAccountId: $('#AccountId').val()}),
            dataType: "json",
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                if (response != null)
                {
                    debugger;
                    $('#btnSave').show();
                    $('#btnGo').hide();
                    $('#AccountId').prop('readonly', true);
                    $('#btnDelete').disable(false);
                    $('#AccountId').val(response.AccountId.toString().trim());
                    $('#Title').val(response.Title.toString().trim());
                    if (response.FaxNo == null) {
                        response.FaxNo = " ";
                    }
                    $('#FaxNo').val(response.FaxNo.toString().trim());
                    $('#ddlAType').val(response.AccType.toString().trim());
                    $('#Nature').val(response.ParentId.toString().trim());
                    $('#LevelKey').val(response.LevelKey.toString().trim());
                    if (response.LevelKey >= 4)
                    {
                        $('#ddlAType').disable(false);
                    }
                    if (response.Address == null) {
                        response.Address = " ";
                    }
                    $('#Address').val(response.Address.toString().trim());
                    if (response.PhoneNo == null) {
                        response.PhoneNo = " ";
                    }
                    $('#PhoneNo').val(response.PhoneNo.toString().trim());
                    if (response.ContactPerson == null) {
                        response.ContactPerson = 1;
                    }
                    $('#ContactPerson').val(response.ContactPerson.toString().trim());
                    if (response.SalesTaxNo == null) {
                        response.SalesTaxNo = " ";
                    }
                    $('#SalesTaxNo').val(response.SalesTaxNo.toString().trim());
                    $('#ddlCity').val(response.CityId.toString().trim());
                    if (response.IsParty)
                    {
                        $('#cbxIsParty').prop('checked', true);
                    }
                    else
                    {
                        $('#cbxIsParty').prop('checked', false);
                    }
                }
                else
                {
                    alert("!No Record Found");
                }
            },
            error: function (response)
            {
                alert(response.responseText);
            }
        });
    }
    function SearchClicked()
    {
        $('#btnGo').show();
        $('#btnSearch').hide();
        $('#AccountId').prop('readonly', false);
        $("#AccountId").focus();
        $('#btnNew').disable(true);
        isNew = false;
        isUpdating = true;
        $('#IsUpdate').val('1');
    }
    function DeleteClicked()
    {
        var answer = confirm("Are you sure you want to delete this account?");
        if (answer)
        {
            $.ajax({
                url: "/Accounts/DeleteAccount",
                type: "POST",
                data: JSON.stringify({ strAccountId: $('#AccountId').val()}),
                dataType: 'text json',
                async: false,
                contentType: 'application/json; charset=utf-8',
                success: function (response) {
                    if (response != null && response.success)
                    {
                        window.location.href = newUrl;
                    } else {
                        alert(response.responseText);
                    }
                },
                error: function (response)
                {
                    alert(response.responseText);
                }
            });
        }
    }
</script>
