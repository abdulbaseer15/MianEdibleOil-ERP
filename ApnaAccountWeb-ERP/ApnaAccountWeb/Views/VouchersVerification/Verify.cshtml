<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    debugger;
    $(document).ready(function () {
        $('#txtVochNo').attr('disabled', 'disabled');
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        $('#txtAccCode').disable(true);
        $('#ddlTitle').disable(true);
        $('#txtDebit').disable(true);
        $('#txtCredit').disable(true);
        $('#txtNarration').disable(true);
        $('#btnDelete').disable(true);
        $('#ddlAType').disable(true);
        $('#btnSave').hide();
        $('#btnGo').hide();
        //$('#cbxPrintJV').disable(true);
        $("#divSelectDis").hide();
        $("#tempdata").hide();
        $('#dtpDate').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpDate').datepicker('setDate', 'now');
    });
    function SearchDV() {
        debugger
        var narration = $('#Narration').val();
       // $('#btnSave').show();
       // $('#btnGo').hide();
        IsUpdate = true;
        $.ajax({
            type: "GET",       // make it get request instead //
            url: "/VouchersVerification/SearchVoucher",
            data: { Narration: narration },
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                $("#mytable tr").remove();
                var new_row;
                $.each(result, function (i, item) {
                    new_row += "<tr id='row" + i + "' ><td class='AccountId'>" + item.AccountId + "</td><td class='Debit'>" + item.Debit + "</td><td class='Credit'>" + item.Credit + "</td><td class='Narration'>" + item.Narration + "</td><td class='VId'>" + item.VId + "</td><td class='VDate'>" + item.VDate + "</td><td class='Vtype'>" + item.Vtype + "</td><td class='Title'>" + item.Title + "</td><td class='RefNo'>" + item.RefNo + "</td></tr>";
                });
                $('#mytable tbody').append(new_row);
                $("#tempdata").show();
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
    }
    function SaveDVoucher() {
        var rowCount = $('#mytable tbody tr').length;
        if (rowCount <= 0) {
            alert("Must have rows to save.")
        }
        else {
            var answer = confirm("Do You really want to Save this?");
            if (answer) {
                var date = $('#dtpDate').val();
                var vid = $('#txtVochNo').val();
                var detail = [];
                $('#mytable tbody tr').each(function () {
                    var $row = $(this), $tds = $row.find("td");
                    var chk = $(this).find('input:checkbox');
                    detail.push({
                        vid: $tds[0].innerText,
                        vtype: $tds[1].innerText,
                        title: $tds[2].innerText,
                        debit: $tds[3].innerText,
                        credit: $tds[4].innerText,
                        narration: $tds[5].innerText,
                        ischecked: chk[0].checked,
                    });
                });
                //var model = {
                //    detail: detail
                //};
                $.ajax({
                    url: "/VouchersVerification/SaveVoucher",
                    type: "POST",
                    data: JSON.stringify({ detail: detail }),
                    dataType: 'text json',
                    async: false,
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        if (response != null && response.success) {
                            alert(response.responseText);
                            window.location.reload();
                        }
                        else {
                            alert(response.responseText);
                        }
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        }
    }
</script>
