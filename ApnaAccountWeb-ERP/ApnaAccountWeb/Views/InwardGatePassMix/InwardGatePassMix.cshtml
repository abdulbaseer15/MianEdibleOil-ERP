                            window.location.reload();
                        }
                        else {
                            alert(response.responseText);
                        }
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        }
        }
    }
    }
    function PrintReport() {
        var vid = $('#compno').val();
        var date = $('#comDate').val();
        if (vid == "" || vid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var string = "rtype=rptInwardGatePassMix" + "&txtAccCode=" + vid + "";
            var url = '@(Url.Action("Report", "Reports", null, Request.Url.Scheme))?' + string
            window.open(url, "_blank");
        }
    }
    function DeleteClicked() {
        //var dvid = $('#ddlTitleinv').val();
       var dvid = $('#compno').val();
        var date = $('#comDate').val();
        if (dvid == "" || dvid == null || date == "" || date == null) {
            alert("Date or invoice id can not be null");
        }
        else {
            var answer = confirm("Do You really want to Delete this?");
            if (answer) {
                $('#btnSave').show();
                $('#btnGo').hide();
                IsUpdate = true;
                var string = "Date=" + date + "&DVId=" + dvid + "";
                var url = '@(Url.Action("DeleteInvoice", "InwardGatePassMix", null, Request.Url.Scheme))?' + string;
                window.location.href = url;
            }
        }
    }
</script>
