    function ratecalcu() {
        if ($('#txtRateL').val() != "" || $('#txtRateL').val() != null) {
            var labourAmount = 0;
            var Bags = parseFloat($('#txtRateL').val()).toFixed(2);
            var sumOfWt = 0;
            var sumOfQty = 0;
            $('#mytable tbody tr').each(function () {
                var $row = $(this), $tds = $row.find("td");
                var t1bags = parseFloat($tds[5].innerText);
                var qty = parseFloat($tds[4].innerText);
                if (isNaN(t1bags)) {
                    t1bags = 0;
                }
                if (isNaN(qty)) {
                    qty = 0;
                }
                sumOfQty = sumOfQty + qty;
                sumOfWt = sumOfWt + t1bags;
            });
            if ($('#cbxLabour').prop('checked')) {
                labourAmount = parseFloat(Bags) * (parseFloat(sumOfWt) / 40);
            }
            else {
                labourAmount = parseFloat(Bags) * (parseFloat(sumOfQty));
            }
            $('#txtLAmt').val(labourAmount.toFixed(2));
            var nettxt = parseFloat($('#txtnettamount').val());
            var txtBAmt = parseFloat($('#txtBAmt').val());
            var txtLAmt = parseFloat($('#txtLAmt').val());
            var txtFAmt = parseFloat($('#txtFAmt').val());
            var txtSAmt = parseFloat($('#txtSAmt').val());
            var txtDiscount = parseFloat($('#txtDiscount').val());
            var txtGst = parseFloat($('#txtGst').val());
            if (isNaN(nettxt))
                nettxt = 0;
            if (isNaN(txtBAmt))
                txtBAmt = 0;
            if (isNaN(txtLAmt))
                txtLAmt = 0;
            if (isNaN(txtFAmt))
                txtFAmt = 0;
            if (isNaN(txtSAmt))
                txtSAmt = 0;
            if (isNaN(txtDiscount))
                txtDiscount = 0;
            if (isNaN(txtGst))
                txtGst = 0;
            $('#nettotal').val(((nettxt + txtBAmt + txtLAmt + txtFAmt + txtSAmt + txtGst) - txtDiscount).toFixed(2));
        }
    }
    function forOrder4() {
        var flag = true;
        var trows = document.getElementById('tblPopup2').rows, t = trows.length, trow;
        var countrow = 0;
        while (--t > -1) {
            trow = trows[t];
            trow.className = 'normal';
            trow.onclick = highlightRow;
        }//end while
        function highlightRow(gethighlight) {
            gethighlight = gethighlight === true;
            var t = trows.length, hrow;
            while (--t > -1) {
                trow = trows[t];
                if (gethighlight && trow.className === 'highlighted')
                { countrow = t + 1; return t; }
                else if (!gethighlight && trow !== this) {
                    trow.className = 'normal';
                }
            }//end while
            return gethighlight ? null : this.className = this.className === 'highlighted' ? 'normal' : 'highlighted';
        }//end function
        function movehighlight(way, e) {
            //e.preventDefault && e.preventDefault();
            //e.returnValue = false;
            var idx = highlightRow(true), nextrow;
            if (typeof idx === 'number') {
                idx += way;
                if (idx && (nextrow = trows[idx])) { return highlightRow.apply(nextrow); }
                else if (idx) { return highlightRow.apply(trows[1]); }
                return highlightRow.apply(trows[trows.length - 1]);
            }
            return highlightRow.apply(trows[way > 0 ? 1 : trows.length - 1]);
        }
        function processkey(e) {
            e = e || event;
            switch (e.keyCode) {
                case 38: {
                    $('#tblPopup2').focus();
                    flag = false;
                    return movehighlight(-1, e)
                }
                case 40: {
                    $('#tblPopup2').focus();
                    flag = true;
                    return movehighlight(1, e);
                }
                case 13: {
                    //if ($("#tblPopupinv").is(":focus"))
                    if ($("#tblPopup2").is(":focus")) {
                        //if (countrow == 0) {
                        //    countrow = countrow + 1;
                        //}
                        if (countrow >= 1) {
                            if (flag == true) {
                                var row = $("tr:eq(" + countrow + ")", tblPopup2)
                                $tds = row.find("td");
                                $('#txtpurCode').val($tds[0].innerText);
                                $('#ddlTitlepur').val($tds[0].innerText);
                                $('#myInput2').val("");
                                $('#myModalpur').modal('hide');
                                //$('#txtbox').focus();
                                isTrue = 1;
                                $('#txtproCode').focus();
                                countrow = -1;
                                return;
                            }
                            if (flag == false) {
                                countrow = countrow - 2;
                                if (countrow < 0) {
                                    countrow = 1;
                                }
                                var row = $("tr:eq(" + countrow + ")", tblPopup2)
                                $tds = row.find("td");
                                $('#txtpurCode').val($tds[0].innerText);
                                $('#ddlTitlepur').val($tds[0].innerText);
                                $('#myInput2').val("");
                                $('#myModalpur').modal('hide');
                                //$('#txtbox').focus();
                                isTrue = 1;
                                $('#txtproCode').focus();
                                countrow = -1;
                                return;
                            }
                        }
                        else if (countrow == 0) {
                            var row = $("tr:eq(1)", tblPopup2)
                            $tds = row.find("td");
                            $('#txtpurCode').val($tds[0].innerText);
                            $('#ddlTitlepur').val($tds[0].innerText);
