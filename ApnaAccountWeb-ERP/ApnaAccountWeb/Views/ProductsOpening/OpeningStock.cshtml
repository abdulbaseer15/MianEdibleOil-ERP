@model ApnaAccountWeb.Models.Product
<script src="~/Content/js/jquery.min.js"></script>
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    $(document).ready(function (e) {
        $('#ddlpgroup').change(function () {
            LoadAllProducts();
        });
        $(document).keypress(function (e) {
            if (e.which == 13) {
                calculateAmount();
                var curIndex = document.activeElement.tabIndex; //get current elements tab index
                var tabbables = document.querySelectorAll("input, textarea, button"); //get all tabable elements
                for (var i = 0; i < tabbables.length; i++) { //loop through each element
                    if (tabbables[i].tabIndex == (curIndex + 1)) { //check the tabindex to see if it's the element we want
                        tabbables[i].focus(); //if it's the one we want, focus it and exit the loop
                        break;
                    }
                }
            }
        });
    });
    function calculateAmount() {
        $('#mytable tbody tr').each(function () {
            var $row = $(this), $tds = $row.find("td");
            var UnitWt = parseFloat($('.debit', this).val());
            var UnitRate = parseFloat($('.credit', this).val());
            var TAmount = UnitWt * UnitRate;
            $('.amount', this).html(TAmount);
        });
    }
    $(function () {
        var focusedElement;
        $(document).on('focus', 'input', function () {
            if (focusedElement == this) return; //already focused, return so user can now place cursor at specific point in input.
            focusedElement = this;
            setTimeout(function () { focusedElement.select(); }, 50); //select all text in any field on focus for easy re-entry. Delay sightly to allow focus to "stick" before selecting.
        });
    });
    function LoadAllProducts() {
        var dvid = $("#ddlpgroup option:selected").attr('value');
        {
            $('#mytable tbody tr').remove();
            $.ajax({
                type: "GET",       // make it get request instead //
                url: "/ProductsOpening/SearchProducts",
                data: { VId: dvid },
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    if (result.length > 0) {
                        var new_row;
                        var n = 0;
                        var j = 1;
                        $.each(result, function (i, item) {
                            j = n + 1;
                            new_row += "<tr id='row" + i + "' ><td class='span2 accCode'>" + item.Productid + "</td><td class='span6 title'>" + item.ProductName + "</td><td><input type='number' class='span11 unitqty' id='unitqty' name='unitqty' required value='" + item.UnitQty + "' tabindex='" + n + "'/></td><td><input type='number' class='span11 debit' id='unitwt' name='unitwt' required value='" + item.UnitWt + "' tabindex='" + n + "'/></td><td class='span4'><input type='number' class='span11 credit' value='" + item.UnitRate + "' id='unitrate' name='unitrate' tabindex='" + j + "' /></td><td class='span2 amount'>" + item.Amounts + "</td></tr>";
                            n = n + 2;
                        });
                        $('#mytable tbody').append(new_row);
                    }
                    else {
                        alert("No record found");
                        window.location.reload();
                    }
                },
                error: function (response) {
                    alert(response.responseText);
                }
            });
        }
    }
    function SaveDVoucher() {
        var detail = [];
        $('#mytable tbody tr').each(function () {
            var $row = $(this), $tds = $row.find("td");
            detail.push({
                Productid: $tds[0].innerText,
                ProductName: $tds[1].innerText,
                UnitWt: $('.debit', this).val(),
                UnitQty: $('.unitqty', this).val(),
                UnitRate: $('.credit', this).val(),
            });
        });
        $.ajax({
            url: "/ProductsOpening/SaveOpeningStock",
            type: "POST",
            data: JSON.stringify({ detail: detail }),
            dataType: 'text json',
            async: false,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {
                if (response != null && response.success) {
                    alert(response.responseText);
                    window.location.reload();
                }
                else {
                    alert(response.responseText);
                }
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
    }
</script>
