<div id="content">
    <div class="row">
        <div class="col-md-12">
            <form action="OpeningBalance" method="Post" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-4 col-sm-3">
                                <b>Opening Stock</b>
                            </div>
                            <div class="col-md-4 col-sm-4 sm-mb-3">
                                @{List<SelectListItem> AccCodelist2 = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.pgroupDetails)
                                    {
                                        AccCodelist2.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Convert.ToString(Acc.Code),
                                        });
                                    }
                                }
                                @Html.DropDownListFor(u => u.PG_ID, AccCodelist2, "Select Product Group", new { id = "ddlpgroup", @class = "form-control form-control-sm" })
                            </div>
                            <div class="col-md-4 col-sm-5">
                                <input type="text" class="form-control form-control-sm" id="myInput" onkeyup="myFunction()" placeholder="Search for Product">
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div style="overflow: auto; height: calc(100vh - 305px)">
                            <table class="table table-bordered" id="mytable">
                                <thead>
                                    <tr class="fixed-thead">
                                        <th>Code</th>
                                        <th>Title</th>
                                        <th>Unit Qty</th>
                                        <th>Unit Wt</th>
                                        <th>Unit Rate</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @*@if (null != ViewBag.AccCodeDetails)
                                        {
                                            var i = 0;
                                             foreach (var Acc in ViewBag.AccCodeDetails)
                                                {
                                                    var j = i + 1;
                                        <tr>
                                            <td>@Acc.Productid</td>
                                            <td>@Acc.ProductName</td>
                                            <td><input type="number" class="span11 debit" id="unitqty" tabindex="@i" name="unitqty" required value="@Acc.UnitQty"  /></td>
                                            <td><input type="number" class="span11 credit" id="unitrate" tabindex="@j" name="unitrate" required value="@Acc.UnitRate" /></td>
                                            <td class="amount">@Acc.Amounts</td>
                                        </tr>
                                                    i = i + 2;
                                                }
                                        }*@
                                </tbody>
                            </table>
                        </div>
                        @* <center style="margin-top:4px;margin-bottom:4px">
                                   <input type="button" value="Update" id="btnSave" class="btn btn-success" onclick='SaveDVoucher();'>
                            </center>*@
                    </div>
                    <div class="card-footer">
                        <input type="button" value="Update" id="btnSave" class="btn btn-success" onclick='SaveDVoucher();'>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    function myFunction() {
        var input, filter, table, tr, td, i;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("mytable");
        tr = table.getElementsByTagName("tr");
        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[0];
            if (td) {
                if (td.innerHTML.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
</script>
