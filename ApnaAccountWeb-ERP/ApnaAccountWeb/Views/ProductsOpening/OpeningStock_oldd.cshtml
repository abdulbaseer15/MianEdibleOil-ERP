    function SaveDVoucher() {
        var Date = $('#comDate').val();
            var detail = [];
            $('#mytable tbody tr').each(function () {
                var $row = $(this), $tds = $row.find("td");
                detail.push({
                    Productid: $tds[0].innerText,
                    ProductName: $tds[1].innerText,
                    UnitQty: $('.debit', this).val(),
                    UnitRate: $('.credit', this).val(),
                    Amounts: $('.suprate', this).val(),
                });
            });
                    $.ajax({
                        url: "/ProductsRate/SaveRate",
                        type: "POST",
                        data: JSON.stringify({ detail: detail, Date: Date }),
                        dataType: 'text json',
                        async: false,
                        contentType: 'application/json; charset=utf-8',
                        success: function (response) {
                            if (response != null && response.success) {
                                alert(response.responseText);
                                window.location.reload();
                            }
                            else {
                                alert(response.responseText);
                            }
                        },
                        error: function (response) {
                            alert(response.responseText);
                        }
                    });
    }
    function PrintRates() {
        alert();
        $("#View").trigger("click");
    }
</script>
