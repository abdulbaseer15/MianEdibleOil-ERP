@model IEnumerable<ApnaAccountWeb.Models.Product>
<link rel="stylesheet" href="~/Content/css/uniform.css" />
<link rel="stylesheet" href="~/Content/css/select2.css" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
       alert("@TempData["message"]");
    </script>
}
<div id="content">
  <div class="container-fluid">
    <div class="row-fluid">
      <div class="span12">
          <a href="@Url.Action("RegisterProduct", "Product", new {@class="btn btn-primary" })" style="float:right">Add Product </a>
        <div class="widget-box">
          <div class="widget-title">
             <span class="icon"><i class="icon-th"></i></span> 
            <h5>Products List</h5>
          </div>
          <div class="widget-content nopadding">
            <table class="table table-bordered data-table" @*style="width:100%"*@>
              <thead>
                <tr>
                  <th>Serial</th>
                  <th>Name</th>
                     <th>Group</th>
                    <th>Type</th>
                  <th>Purchase Price</th>
                  <th>Sale Price</th>
                    <th>Reorder level</th>
                    <th>Remarks</th>
                     <th>Action</th>
                </tr>
              </thead>
              <tbody>
                  @{
                  int i=1;
                  }
                @foreach (var item in Model) {
                    string dbcon = Convert.ToString(Session["con"]);
                    ApnaAccountWeb.ViewModels.DbConection obj = new ApnaAccountWeb.ViewModels.DbConection();
                    string condb = obj.Connect(dbcon);
                    ApnaAccountWeb.Models.ApnaAccountEntities db = new ApnaAccountWeb.Models.ApnaAccountEntities(condb);
                                        <tr>
                                            <td>@Html.DisplayFor(u => item.ProductID)</td>
                                            <td>@Html.DisplayFor(u=>item.ProductName)</td>
                                            <td>@db.ProductGroups.Where(x=>x.PG_Id==item.PG_ID).Select(x=>x.Title).FirstOrDefault()</td>
                                            <td>@db.ProductSubGroups.Where(x => x.PSG_Id == item.PT_ID).Select(x => x.Title).FirstOrDefault()</td>
                                            <td>@Html.DisplayFor(u=>item.PurchasePrice)</td>
                                            <td>@Html.DisplayFor(u=>item.SalePrice)</td>
                                             <td>@Html.DisplayFor(u=>item.ReorderLevel)</td>
                                             <td>@Html.DisplayFor(u=>item.Remarks)</td>
                                            <td>@Html.ActionLink("Edit", "Edit", new { id = @item.ProductID }) |@Html.ActionLink("Delete", "Delete", new { id = @item.ProductID })</td>
                                        </tr>
                    i++;
                                        }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="~/Content/js/jquery.min.js"></script> 
<script src="~/Content/js/jquery.ui.custom.js"></script>
<script src="~/Content/js/jquery.uniform.js"></script> 
<script src="~/Content/js/select2.min.js"></script> 
<script src="~/Content/js/jquery.dataTables.min.js"></script> 
<script src="~/Content/js/maruti.js"></script>
<script src="~/Content/js/maruti.tables.js"></script>
