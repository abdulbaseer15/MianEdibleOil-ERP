<div id="content">
    <div class="row">
        <div class="col-md-12">
            <form action=""  id="frm1" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <b>Create Product</b>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Product Name</label>
                                    <input type="text" class="form-control form-control-sm" id="ProductName" required name="ProductName" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Group</label>
                                    @{List<SelectListItem> AccCodelist2 = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.pgroupDetails)
                                    {
                                        AccCodelist2.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Convert.ToString(Acc.Code),
                                        });
                                    }
                                    }
                                    @Html.DropDownListFor(u => u.PG_ID, AccCodelist2, new { id = "ddlpgroup", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Type</label>
                                    @{List<SelectListItem> AccCodelist = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.makerDetails)
                                    {
                                        AccCodelist.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Convert.ToString(Acc.Code),
                                        });
                                    }
                                    }
                                    @Html.DropDownListFor(u => u.PT_ID, AccCodelist, new { id = "ddlmaker", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            @*<div class="col-md-4">
                            <div class="form-group">
                                <label>Product Unit</label>
                                @{List<SelectListItem> AccCodelist3 = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.punitDetails)
                                    {
                                        AccCodelist3.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Convert.ToString(Acc.Code),
                                        });
                                    }
                                }
                                @Html.DropDownListFor(u => u., AccCodelist3, new { id = "ddlpunit", @class = "form-control form-control-sm" })
                            </div>
                        </div>*@
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Sale Mond Weight</label>
                                    <input type="number" class="form-control form-control-sm" value="1" id="SMW" name="SMW" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Pur Mond Weight</label>
                                    <input type="number" class="form-control form-control-sm" value="1" id="PMW" name="PMW" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Gst Rate</label>
                                    <input type="number" class="form-control form-control-sm" id="GstRate" name="GstRate" required />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Sale Price</label>
                                    <input type="number" class="form-control form-control-sm" id="SalePrice" name="SalePrice" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Purchase Price</label>
                                    <input type="number" class="form-control form-control-sm" id="PurchasePrice" name="PurchasePrice" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Reorder level</label>
                                    <input type="number" class="form-control form-control-sm" id="ReorderLevel" name="ReorderLevel" required />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Rate Calculation 1</label>
                                    <select id="RateCalc1" name="RateCalc1" class="form-control form-control-sm">
                                        <option></option>
                                        <option>Bags</option>
                                        <option>Kg</option>
                                        <option>Mond</option>
                                        <option>PIECES</option>
                                        <option>METER</option>
                                        <option>FEET</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Rate Calculation 2</label>
                                    <select id="RateCalc2" name="RateCalc2" class="form-control form-control-sm">
                                        <option></option>
                                        <option>Purchase Price</option>
                                        <option>Sale Price</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Discount Account</label>
                                    <input type="text" class="form-control form-control-sm" id="StrCol3" name="StrCol3" data-toggle="tooltip" title="Press enter and select account code" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Discount Title</label>
                                    @{List<SelectListItem> AccCodelistdis = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.AccCodelistdis1)
                                    {
                                        AccCodelistdis.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Acc.AccountId
                                        });
                                    }
                                    }
                                    @Html.DropDownListFor(u => u.StrCol3, AccCodelistdis, "-- Select Account --", new { id = "ddlTitlesupdis", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Purchase Account</label>
                                    <input type="text" class="form-control form-control-sm" id="StrCol1" name="StrCol1" data-toggle="tooltip" title="Press enter and select account code" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Purchase Title</label>
                                    @{List<SelectListItem> AccCodelistpur = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.AccCodelistpur1)
                                    {
                                        AccCodelistpur.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Acc.AccountId
                                        });
                                    }
                                    }
                                    @Html.DropDownListFor(u => u.StrCol1, AccCodelistpur, "-- Select Account --", new { id = "ddlTitlesup", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Sale Account</label>
                                    <input type="text" class="form-control form-control-sm" id="StrCol2" name="StrCol2" data-toggle="tooltip" title="Press enter and select account code" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Sale Title</label>
                                    @{List<SelectListItem> AccCodelistSale = new List<SelectListItem>();
                                    foreach (var Acc in ViewBag.AccCodelistSale1)
                                    {
                                        AccCodelistSale.Add(new SelectListItem
                                        {
                                            Text = Acc.Title,
                                            Value = Acc.AccountId
                                        });
                                    }
                                    }
                                    @Html.DropDownListFor(u => u.StrCol2, AccCodelistSale, "-- Select Account --", new { id = "ddlTitlepur", @class = "form-control form-control-sm" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label>Remarks</label>
                                    <textarea name="Remarks" id="Remarks" class="form-control form-control-sm"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="row">
