<div id="content">
    <div class="row">
        <div class="col-md-6">
            <form action="RegisterProductGroup" method="Post" enctype="multipart/form-data" class="form-horizontal">
                <div class="card">
                    <div class="card-header">
                        <b>Create Plant</b>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" class="form-control form-control-sm" id="Title" name="Title" required placeholder="Name" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-2">
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                            </div>
                            <div class="col-md-6 col-sm-6 col-10">
                                <div class="text-right">
                                    <a class="btn btn-sm btn-default" href="@Url.Action("ViewPlant", "Plant")">View Plants</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
