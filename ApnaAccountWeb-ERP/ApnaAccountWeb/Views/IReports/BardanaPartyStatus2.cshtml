@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dtpDatefrom').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDateto').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpDatefromIcon').click(function () {
                $('#dtpDatefrom').datepicker('show');
            });
            $('#dtpDatetoIcon').click(function () {
                $('#dtpDateto').datepicker('show');
            });
            $('#dtpDatefrom').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDatefrom').datepicker('setDate', 'now');

            $('#dtpDateto').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpDateto').datepicker('setDate', 'now');
        });
    </script>
}  