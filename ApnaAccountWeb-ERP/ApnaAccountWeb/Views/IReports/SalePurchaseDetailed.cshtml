                                                AccCodelist.Add(new SelectListItem
                                                {
                                                    Text = Acc.Title,
                                                    Value = Acc.AccountId,
                                                });
                                            }
                                        }
                                        @Html.DropDownListFor(u => u.AccTitle, AccCodelist, "-- Select Account --", new { id = "ddlTitle", Name = "ddlTitle", @class = "span11 ddl" })
                                    </div>
                                </div>
                                @*New Added*@
                                <div class="control-group">
                                    <label class="control-label">Product Code:</label>
                                    <div class="controls">
                                        <input type="text" class="span11" id="txtProAccCode" name="txtProAccCode" data-toggle="tooltip" title="Press enter and select account code" />
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Product:</label>
                                    <div class="controls">
                                        @{List<SelectListItem> AccCodelistproduct = new List<SelectListItem>();
                                            foreach (var Acc in ViewBag.AccCodeDetails2)
                                            {
                                                AccCodelistproduct.Add(new SelectListItem
                                                {
                                                    Text = Convert.ToString(Acc.Title),
                                                    Value = Convert.ToString(Acc.Code),
                                                });
                                            }
                                        }
                                        @Html.DropDownListFor(u => u.AccTitle, AccCodelistproduct, "-- Select Product --", new { id = "ddlTitleproduct", Name = "ddlTitleproduct", @class = "span11 ddl" })
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Type:</label>
                                    <div class="controls">
                                        @{List<SelectListItem> AccCodelisttype = new List<SelectListItem>();
                                            AccCodelisttype.Add(new SelectListItem
                                            {
                                                Text = "Purchase",
                                                Value = "Purchase",
                                            });
                                            AccCodelisttype.Add(new SelectListItem
                                            {
                                                Text = "PurchaseReturn",
                                                Value = "PurchaseReturn",
                                            });
                                            AccCodelisttype.Add(new SelectListItem
                                            {
                                                Text = "Sale",
                                                Value = "Sale",
                                            });
                                            AccCodelisttype.Add(new SelectListItem
                                            {
                                                Text = "SaleReturn",
                                                Value = "SaleReturn",
                                            });
                                        }
                                        @Html.DropDownListFor(u => u.AccTitle, AccCodelisttype, "-- Select Account --", new { id = "ddlTitletype", Name = "ddlTitletype", @class = "span11 ddl" })
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">Group:</label>
                                    <div class="controls">
                                        @{List<SelectListItem> AccCodelistgroup = new List<SelectListItem>();
                                            AccCodelistgroup.Add(new SelectListItem
                                            {
                                                Text = "Party",
                                                Value = "Party",
                                            });
                                            AccCodelistgroup.Add(new SelectListItem
                                            {
                                                Text = "Product",
                                                Value = "Product",
                                            });
                                        }
                                        @Html.DropDownListFor(u => u.AccTitle, AccCodelistgroup, "-- Select Account --", new { id = "ddlTitlegroup", Name = "ddlTitlegroup", @class = "span11 ddl" })
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">From:</label>
                                    <div class="controls">
                                        <input type="text" class="span11 datepicker" id="dtpDatefrom" name="dtpDatefrom" />
                                    </div>
                                </div>
                                <div class="control-group">
                                    <label class="control-label">To:</label>
                                    <div class="controls">
                                        <input type="text" class="span11 datepicker" id="dtpDateto" name="dtpDateto" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <input type="button" value="View" id="btnSearch" class="btn btn-success" onclick='ViewClicked();' />
                                    <input type="button" id="btnPrint1" value="Export into Excel" class="btn btn-success" style="background-color: #062f70" onclick='ExportExcel();'>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}
