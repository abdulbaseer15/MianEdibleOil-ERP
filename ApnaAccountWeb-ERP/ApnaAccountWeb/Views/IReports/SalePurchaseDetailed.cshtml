                                <div class="control-group">
                                    <label class="control-label">Title:</label>
                                    <div class="controls">
                                        @{List<SelectListItem> AccCodelist = new List<SelectListItem>();
                                            foreach (var Acc in ViewBag.AccCodeDetails)
