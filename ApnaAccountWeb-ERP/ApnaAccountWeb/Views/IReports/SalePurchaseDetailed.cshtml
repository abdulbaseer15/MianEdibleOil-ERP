{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    var isCheck = 0;
    var visibleArrayLength = 0;
    var counter = 0;
    var arrVisible = new Array();
    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $('#txtAccCode').focus();
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpDatefrom').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDatefrom').datepicker('setDate', 'now');
        //$('#dtpDateto').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtAccCode').keyup(function (e) {
            if (e.which == 27) {
                $('#txtDiscount').focus();
            }
        });
        $('#txtAccCode').keypress(function (e) {
            debugger;
            if (e.which == 13) {
                $('#myModal').modal('show');
                $('#myInput').focus();
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    debugger;
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        debugger;
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                if (e.keyCode == 27) {
                    $.modal.close();
                }
                $('#tblPopup tr').click(function () {
                    debugger;
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    $('#ddlTitle').val($tds[0].innerText);
                    //$('#txtrate').val(parseFloat($tds[2].innerText));
                    //$('#txtunit').val($tds[3].innerText);
                    //$('#piecesperbox').val($tds[4].innerText);
                    //$('#ddltitlesupbardana').focus();
                    $('#myModal').modal('hide');
                    $('#myInput').val("");
                    $('#txtProAccCode').focus();
                });
            }
        });
        $("#txtAccCode").focusout(function () {
            debugger;
            if ($('#txtAccCode').val() != "" || $('#txtAccCode').val() != null) {
                var code = $('#txtAccCode').val();
                $('#tblPopup tbody tr').each(function () {
                    debugger;
                    var $row = $(this), $tds = $row.find("td");
                    if ($tds[0].innerText == code) {
                        $('#txtAccCode').val($tds[0].innerText);
                        $('#ddlTitle').val($tds[0].innerText);
                        $('#txtProAccCode').focus();
                        $('#myModal').modal('hide');
                        $('#myInput').val("");
                        return;
                    }
                });
            }
        });
        $('#ddlTitleproduct').change(function () {
            var selectedVal = $('#ddlTitleproduct option:selected').attr('value');
            $('#txtProAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitleproduct");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtProAccCode').keyup(function (e) {
            if (e.which == 27) {
                $('#txtDiscount').focus();
            }
        });
        $('#txtProAccCode').keypress(function (e) {
            debugger;
            if (e.which == 13) {
                $('#myModalpro').modal('show');
                $('#myInput3').focus();
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    debugger;
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        debugger;
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                if (e.keyCode == 27) {
                    $.modal.close();
                }
                $('#tblPopup3 tr').click(function () {
                    debugger;
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtProAccCode').val($tds[0].innerText);
                    $('#ddlTitleproduct').val($tds[0].innerText);
                    //$('#txtrate').val(parseFloat($tds[2].innerText));
                    //$('#txtunit').val($tds[3].innerText);
                    //$('#piecesperbox').val($tds[4].innerText);
                    //$('#ddltitlesupbardana').focus();
                    $('#myModalpro').modal('hide');
                    $('#myInput3').val("");
                    $('#txtDebit').focus();
                });
            }
        });
        $("#txtProAccCode").focusout(function () {
            debugger;
            if ($('#txtProAccCode').val() != "" || $('#txtProAccCode').val() != null) {
                var code = $('#txtProAccCode').val();
                $('#tblPopup3 tbody tr').each(function () {
                    debugger;
                    var $row = $(this), $tds = $row.find("td");
                    if ($tds[0].innerText == code) {
                        $('#txtProAccCode').val($tds[0].innerText);
                        $('#ddlTitleproduct').val($tds[0].innerText);
                        $('#txtDebit').focus();
                        $('#myModalpro').modal('hide');
                        $('#myInput3').val("");
                        return;
                    }
                });
            }
        });
    });
    function ViewClicked() {
        var excel = "No";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var product = $('#ddlTitleproduct').val();
        var type = $('#ddlTitletype').val();
        var group = $('#ddlTitlegroup').val();
        var e = document.getElementById("ddlTitle");
        var title = e.options[e.selectedIndex].text;
        var rtype = $('#rtype').val();
        var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&excel=" + excel + "&title=" + title + "&product=" + product + "&type=" + type + "&group=" + group + "";
        var url = '@(Url.Action("Report", "IReports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
    function ExportExcel() {
        var excel = "Yes";
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        txtAccCode = txtAccCode.replace(/\s/g, '');
        //var title = $('#title').val();
        var product = $('#ddlTitleproduct').val();
        var type = $('#ddlTitletype').val();
        var group = $('#ddlTitlegroup').val();
        var e = document.getElementById("ddlTitle");
        var title = e.options[e.selectedIndex].text;
        var rtype = $('#rtype').val();
       var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&excel=" + excel + "&title=" + title + "&product=" + product + "&type=" + type + "&group=" + group + "";
        var url = '@(Url.Action("Report", "IReports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span3">
                </div>
                <div class="span5">
