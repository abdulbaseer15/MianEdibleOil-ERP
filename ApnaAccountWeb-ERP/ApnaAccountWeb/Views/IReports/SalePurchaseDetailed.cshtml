    function forOrder1() {
        debugger;
        var flag = true;
        var searched = false;
        var trows = document.getElementById('tblPopup').rows, t = trows.length, trow;
        var i = 0;
        visibleArrayLength = arrVisible.length;
        var countrow = 0;
        while (--t > -1) {
            trow = trows[t];
            trow.className = 'normal';
            trow.onclick = highlightRow;
        }
        function highlightRow(gethighlight) {
            debugger;
            gethighlight = gethighlight === true;
            var t = trows.length, hrow;
            if (counter == visibleArrayLength) {
                trow = trows[arrVisible[counter - 1]];
                trow.className = 'normal';
                counter = 0;
            }
            if (visibleArrayLength == (trows.length) - 1) {
                while (--t > -1) {
                    trow = trows[t];
                    if (gethighlight && trow.className === 'highlighted') { countrow = t; return t; }
                    else if (!gethighlight && trow !== this) {
                        trow.className = 'normal';
                    }
                }
            }
            else {
                if (visibleArrayLength > 0 && counter <= visibleArrayLength) {
                    if (counter > 0) {
                        trow = trows[arrVisible[counter - 1]];
                        trow.className = 'normal';
                    }
                    trow = trows[arrVisible[counter]];
                    trow.className = 'highlighted';
                    countrow = arrVisible[counter];
                    counter++;
                    searched = true;
                    t = -1;
                    return;
                }
            }
            return gethighlight ? null : this.className = this.className === 'highlighted' ? 'normal' : 'highlighted';
        }
        function movehighlight(way, e) {
            debugger;
            if (visibleArrayLength == (trows.length) - 1) {
                var idx = highlightRow(true), nextrow;
            }
            else {
                var idx = null;
            }
            if (typeof idx === 'number') {
                idx += way;
                if (idx && (nextrow = trows[idx])) { return highlightRow.apply(nextrow); }
                else if (idx) { return highlightRow.apply(trows[1]); }
                return highlightRow.apply(trows[trows.length - 1]);
            }
            return highlightRow.apply(trows[way > 0 ? 1 : trows.length - 1]);
        }
        function processkey(e) {
            debugger;
            e = e || event;
            switch (e.keyCode) {
                case 38: {
                    $('#tblPopup').focus();
                    //counter--;
                    flag = false;
                    return movehighlight(-1, e)
                }
                case 40: {
                    $('#tblPopup').focus();
                    //alert();
                    flag = true;
                    return movehighlight(1, e);
                }
                case 13: {
                    //if ($("#tblPopupinv").is(":focus"))
                    if ($("#tblPopup").is(":focus")) {
                        //if (countrow == 0) {
                        //    countrow = countrow + 1;
                        //}
                        if (countrow >= 0) {
                            if (flag == true) {
                                if (searched == false) {
                                    countrow = countrow + 1;
                                    if (countrow > visibleArrayLength) {
                                        countrow = countrow - visibleArrayLength;
                                    }
                                }
                                var row2 = $("tr:eq(" + countrow + ")", tblPopup)
                                $tds = row2.find("td");
                                $('#txtAccCode').val($tds[0].innerText);
                                var str = $('#txtAccCode').val();
                                str = str.replace(/\s/g, '');
                                $('#txtAccCode').val(str)
                                $('#ddlTitle').val(str);
                                $('#myModal').modal('hide');
                                $('#myInput').val("");
                                isCheck = 1;
                                $('#txtDebit').focus();
                                countrow = -1;
                                return;
                            }
                            if (flag == false) {
                                if (searched == false) {
                                    if (countrow == 0) {
                                        countrow = visibleArrayLength;
                                    }
                                    else {
                                        countrow = countrow - 1;
                                    }
                                    if (countrow < 0) {
                                        countrow = 1;
                                    }
                                }
                                var row = $("tr:eq(" + countrow + ")", tblPopup)
                                $tds = row.find("td");
                                $('#txtAccCode').val($tds[0].innerText);
                                var str = $('#txtAccCode').val();
                                str = str.replace(/\s/g, '');
                                $('#txtAccCode').val(str)
                                $('#ddlTitle').val(str);
                                $('#ddlTitle').focus();
                                $('#myModal').modal('hide');
                                $('#myInput').val("");
                                isCheck = 1;
                                $('#txtDebit').focus();
                                countrow = -1;
                                return;
                            }
                        }
                    }
                }
                default: {
                    return true;
                }
            }
        }
        document.onkeydown = processkey;
    }
    function myFunction() {
        debugger;
        var myInput, filter, table, tr, td, i;
        myInput = document.getElementById("myInput");
        filter = myInput.value.toUpperCase();
        table = document.getElementById("tblPopup");
        tr = table.getElementsByTagName("tr");
        arrVisible = [];
