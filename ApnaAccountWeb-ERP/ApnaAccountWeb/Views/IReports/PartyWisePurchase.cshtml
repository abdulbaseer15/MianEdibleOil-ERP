    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $('#txtAccCode').focus();
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpDatefrom').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDatefrom').datepicker('setDate', 'now');
        //$('#dtpDateto').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpDateto').datepicker('setDate', 'now');
        $('#ddlTitle').change(function () {
            var selectedVal = $('#ddlTitle option:selected').attr('value');
            $('#txtAccCode').val(selectedVal);
            var e = document.getElementById("ddlTitle");
            var title = e.options[e.selectedIndex].text;
            $('#title').val(title);
        });
        $('#txtAccCode').keypress(function (e) {
            if (e.which == 13) {
                forOrder();
                $('#myModal').modal('show');
                $('#myModal a:first-child').focus();
                $('.textboxSearch').focus()
                var $rows = $('#tblPopup tr');
                $('.textboxSearch').keyup(function (e) {
                    var val = '^(?=.*\\b' + $.trim($(this).val()).split(/\s+/).join('\\b)(?=.*\\b') + ').*$',
                    reg = RegExp(val, 'i'),
                    text;
                    $rows.show().filter(function () {
                        text = $(this).text().replace(/\s+/g, ' ');
                        return !reg.test(text);
                        $(this).select();
                    }).hide();
                });
                $('#tblPopup tr').click(function () {
                    var $row = $(this).closest("tr"),
                    $tds = $row.find("td");
                    $('#txtAccCode').val($tds[0].innerText);
                    $('#ddlTitle').val($tds[0].innerText);
                    $('#ddlTitle').focus();
                    $('#myModal').modal('hide');
                });
            }
        });
    });
    function forOrder() {
        var flag = true;
        var trows = document.getElementById('tblPopup').rows, t = trows.length, trow;
        var countrow = 0;
        while (--t > -1) {
            trow = trows[t];
            trow.className = 'normal';
            trow.onclick = highlightRow;
        }//end while
        function highlightRow(gethighlight) {
            gethighlight = gethighlight === true;
            var t = trows.length, hrow;
            while (--t > -1) {
                trow = trows[t];
                if (gethighlight && trow.className === 'highlighted')
                { countrow = t + 1; return t; }
                else if (!gethighlight && trow !== this) {
                    trow.className = 'normal';
                }
            }//end while
            return gethighlight ? null : this.className = this.className === 'highlighted' ? 'normal' : 'highlighted';
        }//end function
        function movehighlight(way, e) {
            //e.preventDefault && e.preventDefault();
            //e.returnValue = false;
            var idx = highlightRow(true), nextrow;
            if (typeof idx === 'number') {
                idx += way;
                if (idx && (nextrow = trows[idx])) { return highlightRow.apply(nextrow); }
                else if (idx) { return highlightRow.apply(trows[1]); }
                return highlightRow.apply(trows[trows.length - 1]);
            }
            return highlightRow.apply(trows[way > 0 ? 1 : trows.length - 1]);
        }
        function processkey(e) {
            e = e || event;
            switch (e.keyCode) {
                case 38: {
                    $('#tblPopup').focus();
                    flag = false;
                    return movehighlight(-1, e)
                }
                case 40: {
                    $('#tblPopup').focus();
                    flag = true;
                    return movehighlight(1, e);
                }
                case 13: {
                    //if ($("#tblPopupinv").is(":focus"))
                    if ($("#tblPopup").is(":focus")) {
                        //if (countrow == 0) {
                        //    countrow = countrow + 1;
                        //}
                        if (countrow >= 1) {
                            if (flag == true) {
                                var row = $("tr:eq(" + countrow + ")", tblPopup)
                                $tds = row.find("td");
                                $('#txtAccCode').val($tds[0].innerText);
                                $('#ddlTitle').val($tds[0].innerText);
                                $('#myInput').val("");
                                $('#myModal').modal('hide');
                                isTrue = 1;
                                $('#dtpDatefrom').focus();
                                //$('#txtunit').focus();
                                countrow = -1;
                                return;
                            }
                            if (flag == false) {
                                countrow = countrow - 2;
                                if (countrow < 0) {
                                    countrow = 1;
                                }
                                var row = $("tr:eq(" + countrow + ")", tblPopup)
                                $tds = row.find("td");
                                $('#txtAccCode').val($tds[0].innerText);
                                $('#ddlTitle').val($tds[0].innerText);
                                $('#myInput').val("");
                                $('#myModal').modal('hide');
                                isTrue = 1;
                                $('#dtpDatefrom').focus();
                                // $('#txtunit').focus();
                                countrow = -1;
                                return;
                            }
                        }
                        else if (countrow == 0) {
                            var row = $("tr:eq(1)", tblPopup)
                            $tds = row.find("td");
                            $('#txtAccCode').val($tds[0].innerText);
                            $('#ddlTitle').val($tds[0].innerText);
                            $('#myInput').val("");
                            $('#myModal').modal('hide');
                            isTrue = 1;
                            $('#dtpDatefrom').focus();
                            //$('#txtunit').focus();
                            //alert(countrow);
                            countrow = -1;
                            return;
                        }
                    }
                }
                default: {
                    return true;
                }
            }
        }
        //  row = table.find('tr').eq(index);
        document.onkeydown = processkey;
    }
    function ViewClicked() {
        var dtpDateto = $('#dtpDateto').val();
        var dtpDatefrom = $('#dtpDatefrom').val();
        var txtAccCode = $('#txtAccCode').val();
        //var title = $('#title').val();
        var e = document.getElementById("ddlTitle");
