        var rtype = $('#rtype').val();
         var string = "rtype=" + rtype + "&dtpDatefrom=" + dtpDatefrom + "&dtpDateto=" + dtpDateto + "&txtAccCode=" + txtAccCode + "&title=" + title + "&group=" + "2" + "";
        var url = '@(Url.Action("Report", "IReports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
@if (1 != 1)
{
    <div id="content">
