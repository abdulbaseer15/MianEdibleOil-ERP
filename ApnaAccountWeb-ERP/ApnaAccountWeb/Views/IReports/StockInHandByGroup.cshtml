                                            <div class="input-group-append" id="dtpTDateIcon" data-target="#dtpTDate" data-toggle="datetimepicker">
                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-2">
                                    <button type="button" id="btnView" class="btn btn-sm btn-primary" onclick='ViewClicked();'>View</button>
                                </div>
