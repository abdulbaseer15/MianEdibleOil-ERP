@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dtpTDate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true,
                showAnim: "slideDown",
            });
            $('#dtpTDateIcon').click(function () {
                $('#dtpTDate').datepicker('show');
            });
            $('#dtpTDate').datepicker({
                "format": "dd/mm/yyyy",
                "todayHighlight": true,
                "autoclose": true
            });
            $('#dtpTDate').datepicker('setDate', 'now');
        });
    </script>
} 