@model ApnaAccountWeb.ViewModels.VViewModel
<script src="~/Content/js/jquery.min.js"></script>
<script src="~/Content/Datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/Datepicker/datepicker.css" rel="stylesheet" />
@if (null != TempData["message"])
{
    <script type="text/javascript">
        alert("@TempData["message"]");
    </script>
}
<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        //$('#dtpTDate').datepicker({
        //    "format": "dd/mm/yyyy",
        //    "todayHighlight": true,
        //    "autoclose": true
        //});
        //$('#dtpTDate').datepicker('setDate', 'now');
    });
    function ViewClicked() {
        var tdate = $('#dtpTDate').val();
        var supres = "";
        var string = "rtype=rptStockInHandByGroup" + "&dtpDateto=" + tdate  + "&title=" + supres + "";
        var url = '@(Url.Action("Report", "IReports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
@if (1 != 1)
{
    <div id="content">
        <div class="container-fluid">
            <div class="row-fluid">
                <div class="span4">
                </div>
                <div class="span6">
                    <div class="widget-box">
                        <div class="widget-title">
                            <span class="icon"> <i class="icon-align-justify"></i> </span>
                            <h5>Stock In Hand</h5>
                        </div>
                        <div class="widget-content nopadding">
                            <form enctype="multipart/form-data" class="form-horizontal">
                                <div class="control-group">
                                    <label class="control-label">To Date :</label>
                                    <div class="controls">
                                        <input type="text" class="datepicker" id="dtpTDate" name="dtpTDate" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button id="btnView" class="btn btn-primary" style="margin-left:-60px" onclick='ViewClicked();'>View</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div><hr>
        </div>
    </div>
}
@if (1 == 1)
{
    <div id="content">
        <div class="row">
            <div class="col-md-5">
