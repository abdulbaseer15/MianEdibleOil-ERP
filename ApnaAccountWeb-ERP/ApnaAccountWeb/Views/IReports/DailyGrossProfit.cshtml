<script>
    var IsUpdate = false;
    var dvcid;
    var IsPrintJV = false;
    var RowNo;
    $(document).ready(function () {
        var date = new Date();
        var today = new Date(date.getFullYear(), date.getMonth(), date.getDate());
        $.fn.extend({
            disable: function (state) {
                return this.each(function () {
                    this.disabled = state;
                });
            }
        });
        $('#dtpTDate').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpDatefrom').datepicker({
            "format": "dd/mm/yyyy",
            "todayHighlight": true,
            "autoclose": true
        });
        $('#dtpTDate').datepicker('setDate', 'now');
        $('#dtpDatefrom').datepicker('setDate', 'now');
    });
    function ViewClicked() {
        var tdate = $('#dtpTDate').val();
        var fdate = $('#dtpDatefrom').val();
        //var sort = $("input[name='radios']:checked").val();
        var string = "rtype=rptDailyGrossProfit" + "&dtpDatefrom=" + fdate + "" + "&dtpDateto=" + tdate + "";
        var url = '@(Url.Action("Report", "IReports", null, Request.Url.Scheme))?' + string
        window.open(url, "_blank");
    }
</script>
